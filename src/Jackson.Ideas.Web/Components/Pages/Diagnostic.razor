@page "/diagnostic"

<h1>Blazor Diagnostic Page</h1>

<div class="alert alert-success">
    <h4>✅ Blazor is Working!</h4>
    <p>If you can see this page, Blazor Server is functioning correctly.</p>
</div>

<div class="card">
    <div class="card-header">
        <h5>System Information</h5>
    </div>
    <div class="card-body">
        <p><strong>Current Time:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
        <p><strong>Page Rendered At:</strong> @renderedAt</p>
        <p><strong>Counter Value:</strong> @counter</p>
        
        <button class="btn btn-primary" @onclick="IncrementCounter">
            Increment Counter (Test Interactivity)
        </button>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5>Navigation Test</h5>
    </div>
    <div class="card-body">
        <div class="btn-group">
            <button class="btn btn-outline-primary" @onclick="() => navigation.NavigateTo('/')">Home</button>
            <button class="btn btn-outline-primary" @onclick="() => navigation.NavigateTo('/counter')">Counter</button>
            <button class="btn btn-outline-primary" @onclick="() => navigation.NavigateTo('/test')">Test</button>
            <button class="btn btn-outline-primary" @onclick="() => navigation.NavigateTo('/dashboard')">Dashboard</button>
        </div>
    </div>
</div>

@inject NavigationManager navigation

@code {
    private DateTime renderedAt = DateTime.Now;
    private int counter = 0;

    private void IncrementCounter()
    {
        counter++;
    }
}