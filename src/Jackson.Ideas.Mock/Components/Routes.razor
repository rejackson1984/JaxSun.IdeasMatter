@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(HubLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(HubLayout)">
            <div class="page-not-found">
                <div class="not-found-content" style="background: orange; padding: 20px;">
                    <i class="fas fa-compass not-found-icon"></i>
                    <h1>🔍 ROUTER DEBUG: 404 - Page Not Found</h1>
                    <p>The page you're looking for doesn't exist in assembly: @typeof(Program).Assembly.FullName</p>
                    <p>Current URL: @NavigationManager.Uri</p>
                    <div class="not-found-actions">
                        <a href="/" class="btn btn-primary">
                            <i class="fas fa-home"></i>
                            Return to Home
                        </a>
                        <a href="/dashboard" class="btn btn-secondary">
                            <i class="fas fa-tachometer-alt"></i>
                            Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>

<style>
    .page-not-found {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 2rem;
    }

    .not-found-content {
        text-align: center;
        max-width: 500px;
    }

    .not-found-icon {
        font-size: 4rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
        opacity: 0.6;
    }

    .not-found-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin: 2rem 0;
        flex-wrap: wrap;
    }

    @@media (max-width: 600px) {
        .not-found-actions {
            flex-direction: column;
            align-items: center;
        }
    }
</style>