@page "/design-wizard/{ScenarioId}"
@using Jackson.Ideas.Mock.Services.Interfaces
@using Jackson.Ideas.Mock.Models
@inject IProductDesignService ProductDesignService
@inject IMockDataService MockDataService
@inject NavigationManager Navigation

<PageTitle>Product Design Wizard - Ideas Matter</PageTitle>

<div class="design-wizard-container">
    <!-- Header -->
    <div class="wizard-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <button class="back-button" @onclick="NavigateBack">
                                <i class="fas fa-arrow-left me-2"></i>Back to Scenario
                            </button>
                            <div>
                                <h1 class="wizard-title">Product Design Wizard</h1>
                                <p class="wizard-subtitle">Let's create your software specification</p>
                            </div>
                        </div>
                        <div class="wizard-progress">
                            <div class="progress-info">
                                <span class="progress-text">@(currentStep + 1) of @totalSteps</span>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @(((currentStep + 1) / (double)totalSteps) * 100)%"></div>
                                </div>
                            </div>
                            <div class="demo-actions">
                                <button class="btn btn-outline-warning btn-sm demo-fill-btn" @onclick="FillAllSampleAnswers">
                                    <i class="fas fa-magic me-1"></i>Demo: Fill All
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="wizard-content">
        <div class="container-fluid">
            @if (isLoading)
            {
                <div class="loading-section">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3">Setting up your design session...</p>
                    </div>
                </div>
            }
            else if (currentQuestion != null)
            {
                <div class="question-section">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-xl-6">
                            <div class="question-card">
                                <div class="question-category">@currentQuestion.Category</div>
                                <h2 class="question-text">@currentQuestion.Text</h2>
                                
                                @if (!string.IsNullOrEmpty(currentQuestion.HelpText))
                                {
                                    <p class="question-help">@currentQuestion.HelpText</p>
                                }

                                <div class="answer-section">
                                    @if (currentQuestion.Type == "text")
                                    {
                                        <div class="form-group">
                                            <textarea class="form-control answer-textarea" 
                                                      @bind="currentAnswer" 
                                                      placeholder="Type your answer here..."
                                                      rows="4"></textarea>
                                        </div>
                                    }
                                    else if (currentQuestion.Type == "multiple-choice")
                                    {
                                        <div class="choice-options">
                                            @foreach (var option in currentQuestion.Options)
                                            {
                                                <label class="choice-option">
                                                    <input type="radio" name="answer" value="@option" 
                                                           @onchange="@((e) => currentAnswer = e.Value?.ToString())" />
                                                    <span class="choice-text">@option</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else if (currentQuestion.Type == "boolean")
                                    {
                                        <div class="boolean-options">
                                            @foreach (var option in currentQuestion.Options)
                                            {
                                                <button class="btn @(currentAnswer == option ? "btn-primary" : "btn-outline-primary") boolean-btn"
                                                        onclick="@(() => currentAnswer = option)">
                                                    @option
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(currentQuestion.SampleAnswer))
                                {
                                    <div class="sample-answer-section">
                                        <div class="sample-answer-header">
                                            <i class="fas fa-lightbulb text-warning me-2"></i>
                                            <span class="sample-label">Need inspiration? Here's a sample answer:</span>
                                        </div>
                                        <div class="sample-answer-content">
                                            @currentQuestion.SampleAnswer
                                        </div>
                                        <button class="btn btn-outline-info btn-sm sample-use-btn" @onclick="UseSampleAnswer">
                                            <i class="fas fa-copy me-1"></i>Use This Sample
                                        </button>
                                    </div>
                                }

                                <div class="question-actions">
                                    <button class="btn btn-outline-secondary" 
                                            @onclick="PreviousQuestion" 
                                            disabled="@(currentStep == 0)">
                                        <i class="fas fa-chevron-left me-2"></i>Previous
                                    </button>
                                    <button class="btn btn-primary" 
                                            @onclick="NextQuestion" 
                                            disabled="@string.IsNullOrWhiteSpace(currentAnswer)">
                                        Next<i class="fas fa-chevron-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (isComplete)
            {
                <div class="completion-section">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="completion-card">
                                <div class="completion-icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <h2>Great! Your responses are complete.</h2>
                                <p>We've gathered all the information needed to create your product specification and visual mockup.</p>
                                
                                <div class="next-steps">
                                    <h3>What's Next?</h3>
                                    <div class="step-options">
                                        <button class="btn btn-primary btn-lg" @onclick="GeneratePRD">
                                            <i class="fas fa-file-alt me-2"></i>
                                            Generate Product Requirements
                                        </button>
                                        <button class="btn btn-outline-primary btn-lg" @onclick="CreateMockup">
                                            <i class="fas fa-paint-brush me-2"></i>
                                            Create Visual Mockup
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
