@code {
    [Parameter] public string ScenarioId { get; set; } = "";
    
    private ProductDesignMockSession? currentSession;
    private BusinessIdeaScenario? businessScenario;
    private List<ProductDesignQuestion> questions = new();
    private ProductDesignQuestion? currentQuestion;
    private string currentAnswer = "";
    private int currentStep = 0;
    private int totalSteps = 10;
    private bool isLoading = true;
    private bool isComplete = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBusinessScenario();
        await InitializeSession();
        await LoadQuestions();
        await LoadCurrentQuestion();
        isLoading = false;
    }

    private async Task LoadBusinessScenario()
    {
        var scenarios = await MockDataService.GetAllScenariosAsync();
        businessScenario = scenarios.FirstOrDefault(s => s.Id == ScenarioId);
    }

    private async Task InitializeSession()
    {
        if (businessScenario != null)
        {
            var sessionName = $"{businessScenario.Name} - Design Session";
            currentSession = await ProductDesignService.CreateSessionAsync("demo-user", ScenarioId, sessionName);
        }
    }

    private async Task LoadQuestions()
    {
        questions = await ProductDesignService.GetQuestionBankAsync();
        totalSteps = questions.Count;
    }

    private async Task LoadCurrentQuestion()
    {
        if (currentSession != null)
        {
            currentQuestion = await ProductDesignService.GetNextQuestionAsync(currentSession.Id);
            if (currentQuestion == null)
            {
                isComplete = true;
            }
            else
            {
                // Pre-fill answer if already answered
                if (currentSession.Responses.ContainsKey(currentQuestion.Id))
                {
                    currentAnswer = currentSession.Responses[currentQuestion.Id];
                }
                else
                {
                    currentAnswer = "";
                }
            }
        }
    }

    private async Task NextQuestion()
    {
        if (currentQuestion != null && !string.IsNullOrWhiteSpace(currentAnswer) && currentSession != null)
        {
            await ProductDesignService.SubmitAnswerAsync(currentSession.Id, currentQuestion.Id, currentAnswer);
            currentStep++;
            await LoadCurrentQuestion();
        }
    }

    private async Task PreviousQuestion()
    {
        if (currentStep > 0)
        {
            currentStep--;
            var previousQuestion = questions.Where((q, index) => index == currentStep).FirstOrDefault();
            if (previousQuestion != null)
            {
                currentQuestion = previousQuestion;
                if (currentSession != null && currentSession.Responses.ContainsKey(currentQuestion.Id))
                {
                    currentAnswer = currentSession.Responses[currentQuestion.Id];
                }
            }
        }
    }

    private async Task GeneratePRD()
    {
        if (currentSession != null)
        {
            Navigation.NavigateTo($"/prd-review/{currentSession.Id}");
        }
    }

    private async Task CreateMockup()
    {
        if (currentSession != null)
        {
            Navigation.NavigateTo($"/mockup-preview/{currentSession.Id}");
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo($"/scenario/{ScenarioId}");
    }

    private void UseSampleAnswer()
    {
        if (currentQuestion != null && !string.IsNullOrEmpty(currentQuestion.SampleAnswer))
        {
            currentAnswer = currentQuestion.SampleAnswer;
        }
    }

    private async Task FillAllSampleAnswers()
    {
        if (currentSession != null)
        {
            // Fill all questions with sample answers
            foreach (var question in questions)
            {
                if (!string.IsNullOrEmpty(question.SampleAnswer))
                {
                    await ProductDesignService.SubmitAnswerAsync(currentSession.Id, question.Id, question.SampleAnswer);
                }
            }
            
            // Mark as complete and navigate to completion
            isComplete = true;
            currentQuestion = null;
            await InvokeAsync(StateHasChanged);
        }
    }
}