@page "/business-plan-builder"
@page "/business-plan-builder/{PlanId}"
@layout HubLayout
@using Jackson.Ideas.Mock.Services.Interfaces
@using Jackson.Ideas.Mock.Models
@inject IBusinessPlanBuilderService BusinessPlanService
@inject ICoachPersonaService CoachPersonaService
@inject IHubContextService HubContextService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Business Plan Builder - Strategic Planning Hub</PageTitle>

<div class="business-plan-container">
    @if (_businessPlan != null && _currentCoach != null)
    {
        <!-- Strategy Coach Header -->
        <div class="coach-header-section hub-planning-theme">
            <div class="coach-header-content">
                <div class="coach-avatar-header">
                    <i class="@_currentCoach.Avatar"></i>
                </div>
                <div class="header-text-content">
                    <h1 class="coach-header-title">Strategic Business Plan Builder 📋</h1>
                    <p class="coach-header-message">@GetCoachHeaderMessage()</p>
                    <div class="plan-progress-indicator">
                        <div class="progress-circle-small">
                            <span class="progress-value">@_businessPlan.CompletenessScore%</span>
                        </div>
                        <span class="progress-label">Plan Completeness</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Business Plan Overview -->
        <div class="plan-overview-section">
            <div class="plan-overview-card">
                <div class="plan-header">
                    <h2 class="plan-title">@_businessPlan.BusinessName</h2>
                    <p class="plan-description">@_businessPlan.Description</p>
                    <div class="plan-meta">
                        <span class="meta-item">
                            <i class="fas fa-calendar"></i>
                            Created: @_businessPlan.CreatedAt.ToString("MMM dd, yyyy")
                        </span>
                        <span class="meta-item">
                            <i class="fas fa-edit"></i>
                            Updated: @_businessPlan.UpdatedAt.ToString("MMM dd, yyyy")
                        </span>
                        <span class="meta-item status-indicator @GetPlanStatusClass()">
                            <i class="fas fa-chart-line"></i>
                            @GetPlanStatus()
                        </span>
                    </div>
                </div>
                <div class="plan-actions">
                    <button class="btn btn-secondary" @onclick="ExportPlan">
                        <i class="fas fa-download"></i>
                        Export Plan
                    </button>
                    @if (_businessPlan.ReadyForOperations)
                    {
                        <button class="btn btn-success" @onclick="AdvanceToOperations">
                            <i class="fas fa-rocket"></i>
                            Launch Business Operations
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="ContinueBuilding">
                            <i class="fas fa-edit"></i>
                            Continue Building
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Business Plan Sections -->
        <div class="plan-sections-grid">
            <!-- Executive Summary -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-star section-icon"></i>
                        Executive Summary
                    </h3>
                    <span class="section-score @GetSectionScoreClass(20)">@GetExecutiveSummaryScore()/20</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Business Concept:</strong>
                        <p>@_businessPlan.ExecutiveSummary.BusinessConcept</p>
                    </div>
                    <div class="content-item">
                        <strong>Value Proposition:</strong>
                        <p>@_businessPlan.ExecutiveSummary.ValueProposition</p>
                    </div>
                    <div class="content-item">
                        <strong>Mission Statement:</strong>
                        <p>@_businessPlan.ExecutiveSummary.MissionStatement</p>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("ExecutiveSummary")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>

            <!-- Market Analysis -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-chart-bar section-icon"></i>
                        Market Analysis
                    </h3>
                    <span class="section-score @GetSectionScoreClass(20)">@GetMarketAnalysisScore()/20</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Target Market:</strong>
                        <p>@_businessPlan.MarketAnalysis.TargetMarket</p>
                    </div>
                    <div class="content-item">
                        <strong>Market Size:</strong>
                        <p>@_businessPlan.MarketAnalysis.MarketSize</p>
                    </div>
                    <div class="content-item">
                        <strong>Customer Segments:</strong>
                        <ul class="segment-list">
                            @foreach (var segment in _businessPlan.MarketAnalysis.CustomerSegments)
                            {
                                <li><strong>@segment.Name:</strong> @segment.Description</li>
                            }
                        </ul>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("MarketAnalysis")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>

            <!-- Product Strategy -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-cogs section-icon"></i>
                        Product Strategy
                    </h3>
                    <span class="section-score @GetSectionScoreClass(15)">@GetProductStrategyScore()/15</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Product Description:</strong>
                        <p>@_businessPlan.ProductStrategy.ProductDescription</p>
                    </div>
                    <div class="content-item">
                        <strong>Development Plan:</strong>
                        <p>@_businessPlan.ProductStrategy.DevelopmentPlan</p>
                    </div>
                    <div class="content-item">
                        <strong>Core Features:</strong>
                        <ul class="features-list">
                            @foreach (var feature in _businessPlan.ProductStrategy.CoreFeatures)
                            {
                                <li>
                                    <span class="feature-name">@feature.Name</span>
                                    <span class="feature-priority priority-@feature.Priority.ToLower()">@feature.Priority</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("ProductStrategy")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>

            <!-- Marketing Strategy -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-bullhorn section-icon"></i>
                        Marketing Strategy
                    </h3>
                    <span class="section-score @GetSectionScoreClass(15)">@GetMarketingStrategyScore()/15</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Pricing Strategy:</strong>
                        <p>@_businessPlan.MarketingStrategy.PricingStrategy</p>
                    </div>
                    <div class="content-item">
                        <strong>Customer Acquisition:</strong>
                        <p>@_businessPlan.MarketingStrategy.CustomerAcquisition</p>
                    </div>
                    <div class="content-item">
                        <strong>Marketing Channels:</strong>
                        <ul class="channels-list">
                            @foreach (var channel in _businessPlan.MarketingStrategy.Channels)
                            {
                                <li>
                                    <strong>@channel.Name:</strong> @channel.Strategy
                                    <span class="channel-budget">Budget: @channel.Budget</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("MarketingStrategy")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>

            <!-- Financial Strategy -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-dollar-sign section-icon"></i>
                        Financial Strategy
                    </h3>
                    <span class="section-score @GetSectionScoreClass(15)">@GetFinancialStrategyScore()/15</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Revenue Model:</strong>
                        <p>@_businessPlan.FinancialStrategy.RevenueModel</p>
                    </div>
                    <div class="content-item">
                        <strong>Financial Projections:</strong>
                        <p>@_businessPlan.FinancialStrategy.FinancialProjections</p>
                    </div>
                    <div class="content-item">
                        <strong>Break-Even Analysis:</strong>
                        <p>@_businessPlan.FinancialStrategy.BreakEvenAnalysis</p>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("FinancialStrategy")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>

            <!-- Operations Strategy -->
            <div class="section-card">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-sitemap section-icon"></i>
                        Operations Strategy
                    </h3>
                    <span class="section-score @GetSectionScoreClass(10)">@GetOperationsStrategyScore()/10</span>
                </div>
                <div class="section-content">
                    <div class="content-item">
                        <strong>Operational Model:</strong>
                        <p>@_businessPlan.OperationsStrategy.OperationalModel</p>
                    </div>
                    <div class="content-item">
                        <strong>Technology Infrastructure:</strong>
                        <p>@_businessPlan.OperationsStrategy.TechnologyInfrastructure</p>
                    </div>
                    <div class="content-item">
                        <strong>Key Processes:</strong>
                        <ul class="processes-list">
                            @foreach (var process in _businessPlan.OperationsStrategy.KeyProcesses)
                            {
                                <li><strong>@process.Name:</strong> @process.Description</li>
                            }
                        </ul>
                    </div>
                </div>
                <button class="btn-section-edit" @onclick='() => EditSection("OperationsStrategy")'>
                    <i class="fas fa-edit"></i>
                    Edit Section
                </button>
            </div>
        </div>

        <!-- Strategic Recommendations -->
        @if (_recommendations != null && _recommendations.Any())
        {
            <div class="recommendations-section">
                <h2 class="recommendations-title">
                    <i class="fas fa-lightbulb"></i>
                    Strategic Recommendations from @_currentCoach.Name
                </h2>
                <div class="recommendations-grid">
                    @foreach (var recommendation in _recommendations)
                    {
                        <div class="recommendation-card">
                            <div class="recommendation-header">
                                <h3 class="recommendation-title">@recommendation.Title</h3>
                                <span class="recommendation-priority priority-@recommendation.Priority">
                                    Priority @recommendation.Priority
                                </span>
                            </div>
                            <div class="recommendation-content">
                                <p class="recommendation-description">@recommendation.Description</p>
                                <div class="recommendation-details">
                                    <div class="detail-item">
                                        <strong>Impact:</strong> @recommendation.Impact
                                    </div>
                                    <div class="detail-item">
                                        <strong>Implementation:</strong> @recommendation.Implementation
                                    </div>
                                </div>
                            </div>
                            <div class="recommendation-actions">
                                <button class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-check"></i>
                                    Mark as Implemented
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (_isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner"></div>
            <h2>Building Your Strategic Business Plan...</h2>
            <p>Our Strategy coach is preparing comprehensive business frameworks</p>
        </div>
    }
    else
    {
        <div class="error-state">
            <i class="fas fa-exclamation-triangle"></i>
            <h2>Business Plan Not Found</h2>
            <p>We couldn't find the requested business plan.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/idea-validation")'>
                <i class="fas fa-arrow-left"></i>
                Return to Idea Validation
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? PlanId { get; set; }
    
    private BusinessPlan? _businessPlan;
    private CoachPersona? _currentCoach;
    private List<StrategicRecommendation>? _recommendations;
    private bool _isLoading = true;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadBusinessPlanData();
        _currentCoach = await CoachPersonaService.GetCoachForHubAsync(BusinessHub.BusinessPlanning);
        _isLoading = false;
        StateHasChanged();
    }
    
    private async Task LoadBusinessPlanData()
    {
        var planId = PlanId ?? "demo-plan";
        _businessPlan = await BusinessPlanService.GetBusinessPlanAsync(planId);
        
        if (_businessPlan != null)
        {
            _recommendations = await BusinessPlanService.GetStrategicRecommendationsAsync(_businessPlan.Id);
        }
    }
    
    private string GetCoachHeaderMessage()
    {
        if (_currentCoach == null || _businessPlan == null) return "";
        
        return _businessPlan.CompletenessScore >= 80 
            ? $"Excellent work! Your business plan is comprehensive and ready for operations. {_currentCoach.Name} has identified the key strategic frameworks needed for success."
            : _businessPlan.CompletenessScore >= 60
            ? $"Good progress! {_currentCoach.Name} will guide you through completing the remaining strategic components systematically."
            : $"Let's build a robust business plan together. {_currentCoach.Name} will help you develop each strategic component methodically.";
    }
    
    private string GetPlanStatus()
    {
        return _businessPlan?.CompletenessScore switch
        {
            >= 80 => "Ready for Operations",
            >= 60 => "Strategic Development",
            >= 40 => "Planning in Progress",
            _ => "Initial Framework"
        };
    }
    
    private string GetPlanStatusClass()
    {
        return _businessPlan?.CompletenessScore switch
        {
            >= 80 => "status-ready",
            >= 60 => "status-developing",
            >= 40 => "status-progress",
            _ => "status-initial"
        };
    }
    
    private string GetSectionScoreClass(int maxScore)
    {
        var actualScore = GetSectionActualScore(maxScore);
        var percentage = (double)actualScore / maxScore * 100;
        
        return percentage switch
        {
            >= 80 => "score-excellent",
            >= 60 => "score-good",
            >= 40 => "score-fair",
            _ => "score-poor"
        };
    }
    
    private int GetSectionActualScore(int maxScore)
    {
        // This would be calculated based on actual section completeness
        // For demo purposes, returning a portion of the max score
        return (int)(maxScore * 0.75);
    }
    
    private int GetExecutiveSummaryScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.ExecutiveSummary.BusinessConcept)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.ExecutiveSummary.MissionStatement)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.ExecutiveSummary.ValueProposition)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.ExecutiveSummary.FundingRequirements)) score += 5;
        return score;
    }
    
    private int GetMarketAnalysisScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.MarketAnalysis.TargetMarket)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.MarketAnalysis.MarketSize)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.MarketAnalysis.CompetitiveAnalysis)) score += 5;
        if (_businessPlan?.MarketAnalysis.CustomerSegments.Any() == true) score += 5;
        return score;
    }
    
    private int GetProductStrategyScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.ProductStrategy.ProductDescription)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.ProductStrategy.DevelopmentPlan)) score += 5;
        if (_businessPlan?.ProductStrategy.CoreFeatures.Any() == true) score += 5;
        return score;
    }
    
    private int GetMarketingStrategyScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.MarketingStrategy.PricingStrategy)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.MarketingStrategy.CustomerAcquisition)) score += 5;
        if (_businessPlan?.MarketingStrategy.Channels.Any() == true) score += 5;
        return score;
    }
    
    private int GetFinancialStrategyScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.FinancialStrategy.RevenueModel)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.FinancialStrategy.FinancialProjections)) score += 5;
        if (!string.IsNullOrEmpty(_businessPlan?.FinancialStrategy.BreakEvenAnalysis)) score += 5;
        return score;
    }
    
    private int GetOperationsStrategyScore()
    {
        int score = 0;
        if (!string.IsNullOrEmpty(_businessPlan?.OperationsStrategy.OperationalModel)) score += 5;
        if (_businessPlan?.OperationsStrategy.KeyProcesses.Any() == true) score += 5;
        return score;
    }
    
    private void EditSection(string sectionName)
    {
        // TODO: Navigate to section editor or open modal
        // For demo purposes, just show a message
    }
    
    private async Task ExportPlan()
    {
        if (_businessPlan != null)
        {
            var export = await BusinessPlanService.ExportBusinessPlanAsync(_businessPlan.Id, ExportFormat.PDF);
            // TODO: Download the exported file
        }
    }
    
    private async Task AdvanceToOperations()
    {
        // Switch to Business Operations hub
        await HubContextService.SwitchToHubAsync(BusinessHub.BusinessOperations);
        Navigation.NavigateTo("/dashboard");
    }
    
    private void ContinueBuilding()
    {
        // TODO: Navigate to business plan editor
    }
    
    public void Dispose()
    {
        // No subscriptions to dispose in this component
    }
}

<style>
    .business-plan-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
        background: var(--hub-background, #f8fafc);
    }

    /* Coach Header */
    .coach-header-section {
        margin-bottom: 3rem;
        border-radius: 1rem;
        overflow: hidden;
    }

    .hub-planning-theme {
        background: linear-gradient(135deg, var(--hub-primary, #5a6fd8) 0%, var(--hub-secondary, #3b82f6) 100%);
        color: white;
    }

    .coach-header-content {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 2rem;
    }

    .coach-avatar-header {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .header-text-content {
        flex: 1;
    }

    .coach-header-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .coach-header-message {
        font-size: 1.125rem;
        margin-bottom: 1rem;
        opacity: 0.95;
        line-height: 1.6;
    }

    .plan-progress-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .progress-circle-small {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .progress-value {
        font-size: 0.875rem;
    }

    .progress-label {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    /* Plan Overview */
    .plan-overview-section {
        margin-bottom: 3rem;
    }

    .plan-overview-card {
        background: white;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
    }

    .plan-header {
        flex: 1;
    }

    .plan-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #1a202c;
    }

    .plan-description {
        color: #64748b;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .plan-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: #64748b;
    }

    .status-indicator {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-weight: 600;
    }

    .status-ready { background: #dcfce7; color: #166534; }
    .status-developing { background: #dbeafe; color: #1e40af; }
    .status-progress { background: #fef3c7; color: #92400e; }
    .status-initial { background: #fecaca; color: #991b1b; }

    .plan-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    /* Plan Sections Grid */
    .plan-sections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .section-card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: relative;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e2e8f0;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.125rem;
        font-weight: 600;
        color: #374151;
        margin: 0;
    }

    .section-icon {
        color: var(--hub-primary, #5a6fd8);
    }

    .section-score {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .score-excellent { background: #dcfce7; color: #166534; }
    .score-good { background: #dbeafe; color: #1e40af; }
    .score-fair { background: #fef3c7; color: #92400e; }
    .score-poor { background: #fecaca; color: #991b1b; }

    .section-content {
        padding: 1.5rem;
    }

    .content-item {
        margin-bottom: 1.5rem;
    }

    .content-item:last-child {
        margin-bottom: 0;
    }

    .content-item strong {
        display: block;
        margin-bottom: 0.5rem;
        color: #374151;
        font-weight: 600;
    }

    .content-item p {
        color: #64748b;
        line-height: 1.6;
        margin: 0;
    }

    .segment-list,
    .features-list,
    .channels-list,
    .processes-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .segment-list li,
    .features-list li,
    .channels-list li,
    .processes-list li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f3f4f6;
        color: #64748b;
    }

    .segment-list li:last-child,
    .features-list li:last-child,
    .channels-list li:last-child,
    .processes-list li:last-child {
        border-bottom: none;
    }

    .feature-priority {
        padding: 0.125rem 0.5rem;
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    .priority-high { background: #fecaca; color: #991b1b; }
    .priority-medium { background: #fef3c7; color: #92400e; }
    .priority-low { background: #dcfce7; color: #166534; }

    .channel-budget {
        display: block;
        font-size: 0.875rem;
        color: #64748b;
        margin-top: 0.25rem;
    }

    .btn-section-edit {
        position: absolute;
        top: 1rem;
        right: 1rem;
        padding: 0.5rem 1rem;
        background: var(--hub-primary, #5a6fd8);
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .section-card:hover .btn-section-edit {
        opacity: 1;
    }

    /* Strategic Recommendations */
    .recommendations-section {
        margin-bottom: 3rem;
    }

    .recommendations-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .recommendations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
