@page "/scenario/{ScenarioId}"
@using Jackson.Ideas.Mock.Services.Interfaces
@using Jackson.Ideas.Mock.Models
@inject IMockDataService MockDataService
@inject NavigationManager Navigation

<PageTitle>@(scenario?.Name ?? "Scenario Details") - Ideas Matter Demo</PageTitle>

@if (scenario == null)
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="text-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Loading scenario details...</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid" style="padding-top: 20px;">
        <!-- Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <button class="back-button" @onclick="NavigateToScenarios">
                        <i class="fas fa-arrow-left me-2"></i>Back to Scenarios
                    </button>
                </div>
                <div>
                    <h1 class="h2 mb-1">@scenario.Name</h1>
                    <div class="d-flex gap-2 mb-2">
                        <span class="badge bg-primary fs-6">@scenario.Industry</span>
                        <span class="badge bg-@GetViabilityColor(scenario.ViabilityScore) fs-6">
                            @scenario.ViabilityScore% Viable
                        </span>
                    </div>
                    <p class="text-muted">@scenario.Description</p>
                </div>
            </div>
        </div>

        <!-- Overview Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-success mb-2">
                            <i class="fas fa-dollar-sign fa-2x"></i>
                        </div>
                        <h6 class="card-title">Startup Cost</h6>
                        <h4 class="text-success mb-0">$@(scenario.EstimatedStartupCost.ToString("N0"))</h4>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-primary mb-2">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                        <h6 class="card-title">Projected Revenue</h6>
                        <h4 class="text-primary mb-0">$@(scenario.ProjectedRevenue.ToString("N0"))</h4>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-info mb-2">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                        <h6 class="card-title">Target Market</h6>
                        <p class="mb-0 small">@scenario.TargetMarket</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="text-warning mb-2">
                            <i class="fas fa-trophy fa-2x"></i>
                        </div>
                        <h6 class="card-title">Viability Score</h6>
                        <h4 class="text-@GetViabilityColor(scenario.ViabilityScore) mb-0">@scenario.ViabilityScore%</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Tabs -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom-0 pb-0">
                        <ul class="nav nav-tabs custom-tabs" id="scenarioTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-tab @(activeTab == "overview" ? "active" : "")" 
                                        @onclick="SetOverviewTab">
                                    <i class="fas fa-eye me-2"></i>Overview
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-tab @(activeTab == "market" ? "active" : "")" 
                                        @onclick="SetMarketTab">
                                    <i class="fas fa-chart-bar me-2"></i>Market Research
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-tab @(activeTab == "financial" ? "active" : "")" 
                                        @onclick="SetFinancialTab">
                                    <i class="fas fa-calculator me-2"></i>Financial Projections
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link custom-tab @(activeTab == "analysis" ? "active" : "")" 
                                        @onclick="SetAnalysisTab">
                                    <i class="fas fa-lightbulb me-2"></i>Strategic Analysis
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        @if (activeTab == "overview")
                        {
                            <div class="row">
                                <div class="col-lg-6 mb-4">
                                    <h5><i class="fas fa-info-circle text-primary me-2"></i>Business Concept</h5>
                                    <p>@scenario.Description</p>
                                    
                                    <h6 class="mt-4"><i class="fas fa-bullseye text-info me-2"></i>Target Market</h6>
                                    <p>@scenario.TargetMarket</p>
                                    
                                    <h6 class="mt-4"><i class="fas fa-industry text-secondary me-2"></i>Industry</h6>
                                    <span class="badge bg-primary">@scenario.Industry</span>
                                    
                                    <h6 class="mt-4"><i class="fas fa-calendar text-success me-2"></i>Created</h6>
                                    <p>@scenario.CreatedAt.ToString("MMMM dd, yyyy")</p>
                                </div>
                                <div class="col-lg-6">
                                    <h5><i class="fas fa-exclamation-triangle text-warning me-2"></i>Key Challenges</h5>
                                    <ul class="list-group list-group-flush mb-4">
                                        @foreach (var challenge in scenario.KeyChallenges)
                                        {
                                            <li class="list-group-item px-0">
                                                <i class="fas fa-times text-danger me-2"></i>@challenge
                                            </li>
                                        }
                                    </ul>

                                    <h5><i class="fas fa-star text-success me-2"></i>Success Factors</h5>
                                    <ul class="list-group list-group-flush">
                                        @foreach (var factor in scenario.SuccessFactors)
                                        {
                                            <li class="list-group-item px-0">
                                                <i class="fas fa-check text-success me-2"></i>@factor
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                        else if (activeTab == "market")
                        {
                            <div class="row">
                                <div class="col-lg-6 mb-4">
                                    <h5><i class="fas fa-chart-pie text-primary me-2"></i>Market Segmentation</h5>
                                    <div class="card bg-light border-0 mb-3">
                                        <div class="card-body">
                                            <h6>Total Market Size</h6>
                                            <p class="mb-2">@scenario.MarketResearch.Segmentation.TotalMarketSize</p>
                                            
                                            <h6>Serviceable Market</h6>
                                            <p class="mb-2">@scenario.MarketResearch.Segmentation.ServicableMarketSize</p>
                                            
                                            <h6>Target Market Size</h6>
                                            <p class="mb-2">@scenario.MarketResearch.Segmentation.TargetMarketSize</p>
                                            
                                            <h6>Growth Rate</h6>
                                            <p class="mb-0 text-success">@scenario.MarketResearch.Segmentation.GrowthRate</p>
                                        </div>
                                    </div>
                                    
                                    <h5><i class="fas fa-users text-info me-2"></i>Customer Insights</h5>
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <h6>Primary Customers</h6>
                                            @foreach (var segment in scenario.MarketResearch.Segmentation.Segments.Take(3))
                                            {
                                                <div class="mb-3">
                                                    <strong>@segment.Name</strong>
                                                    <p class="small mb-1">Size: @segment.Size</p>
                                                    <p class="small mb-1">Demographics: @segment.Demographics</p>
                                                    <p class="small">Purchasing Power: @segment.PurchasingPower</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-6">
                                    <h5><i class="fas fa-sword text-danger me-2"></i>Competitive Analysis</h5>
                                    
                                    @if (scenario.MarketResearch.Competition.DirectCompetitors.Any())
                                    {
                                        <h6 class="mt-3">Direct Competitors</h6>
                                        @foreach (var competitor in scenario.MarketResearch.Competition.DirectCompetitors.Take(3))
                                        {
                                            <div class="card bg-light border-0 mb-2">
                                                <div class="card-body py-2">
                                                    <h6 class="mb-1">@competitor.Name</h6>
                                                    <p class="small mb-1"><strong>Market Share:</strong> @competitor.MarketShare</p>
                                                    <p class="small mb-1"><strong>Strengths:</strong> @competitor.Strengths</p>
                                                    <p class="small mb-0"><strong>Weaknesses:</strong> @competitor.Weaknesses</p>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <h6 class="mt-3">Competitive Advantages</h6>
                                    <ul class="list-group list-group-flush">
                                        @foreach (var advantage in scenario.MarketResearch.Competition.CompetitiveAdvantages)
                                        {
                                            <li class="list-group-item px-0">
                                                <i class="fas fa-plus text-success me-2"></i>@advantage
                                            </li>
                                        }
                                    </ul>

                                    <h6 class="mt-3">Market Gaps</h6>
                                    <ul class="list-group list-group-flush">
                                        @foreach (var gap in scenario.MarketResearch.Competition.MarketGaps)
                                        {
                                            <li class="list-group-item px-0">
                                                <i class="fas fa-search text-info me-2"></i>@gap
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                        else if (activeTab == "financial")
                        {
                            <div class="row">
                                <div class="col-lg-8 mb-4">
                                    <h5><i class="fas fa-chart-line text-success me-2"></i>Revenue Projections</h5>
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Period</th>
                                                    <th>Year 1</th>
                                                    <th>Year 3</th>
                                                    <th>Year 5</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><strong>Total Revenue</strong></td>
                                                    <td class="text-success">$@(scenario.FinancialProjections.Revenue.Year1Total.ToString("N0"))</td>
                                                    <td class="text-success">$@(scenario.FinancialProjections.Revenue.Year3Total.ToString("N0"))</td>
                                                    <td class="text-success">$@(scenario.FinancialProjections.Revenue.Year5Total.ToString("N0"))</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    @if (scenario.FinancialProjections.Revenue.Streams.Any())
                                    {
                                        <h6 class="mt-4">Revenue Streams</h6>
                                        @foreach (var stream in scenario.FinancialProjections.Revenue.Streams)
                                        {
                                            <div class="card bg-light border-0 mb-2">
                                                <div class="card-body py-2">
                                                    <h6 class="mb-1">@stream.Name</h6>
                                                    <p class="small mb-1">@stream.Description</p>
                                                    <p class="small mb-1"><strong>Pricing Model:</strong> @stream.PricingModel</p>
                                                    <div class="row">
                                                        <div class="col-4">
                                                            <p class="small mb-0"><strong>Year 1:</strong> $@(stream.Year1Amount.ToString("N0"))</p>
                                                        </div>
                                                        <div class="col-4">
                                                            <p class="small mb-0"><strong>Year 3:</strong> $@(stream.Year3Amount.ToString("N0"))</p>
                                                        </div>
                                                        <div class="col-4">
                                                            <p class="small mb-0"><strong>Year 5:</strong> $@(stream.Year5Amount.ToString("N0"))</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                <div class="col-lg-4">
                                    <h5><i class="fas fa-money-bill-wave text-warning me-2"></i>Cost Structure</h5>
                                    <div class="card bg-light border-0 mb-3">
                                        <div class="card-body">
                                            <h6>Startup Costs</h6>
                                            <p class="text-warning mb-2">$@(scenario.EstimatedStartupCost.ToString("N0"))</p>
                                            
                                            <h6>Operating Expenses</h6>
                                            <p class="mb-2"><strong>Year 1:</strong> $@(scenario.FinancialProjections.Expenses.Year1Total.ToString("N0"))</p>
                                            <p class="mb-2"><strong>Year 3:</strong> $@(scenario.FinancialProjections.Expenses.Year3Total.ToString("N0"))</p>
                                            <p class="mb-0"><strong>Year 5:</strong> $@(scenario.FinancialProjections.Expenses.Year5Total.ToString("N0"))</p>
                                        </div>
                                    </div>

                                    <h5><i class="fas fa-chart-bar text-info me-2"></i>Key Metrics</h5>
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            @if (scenario.FinancialProjections.Metrics != null)
                                            {
                                                <p class="mb-2"><strong>Break-even Point:</strong> @(scenario.FinancialProjections.Metrics.PaybackPeriodMonths) months</p>
                                                <p class="mb-2"><strong>ROI (Year 5):</strong> @(scenario.FinancialProjections.Metrics.ReturnOnInvestment.ToString("F1"))%</p>
                                                <p class="mb-0"><strong>Net Margin:</strong> @(scenario.FinancialProjections.Metrics.NetMarginPercent.ToString("F1"))%</p>
                                            }
                                            else
                                            {
                                                <p class="text-muted">Financial metrics will be calculated based on projections.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (activeTab == "analysis")
                        {
                            <div class="row">
                                <div class="col-lg-6 mb-4">
                                    <h5><i class="fas fa-lightbulb text-warning me-2"></i>Strategic Recommendations</h5>
                                    <div class="alert alert-info">
                                        <h6>Business Model</h6>
                                        <p class="mb-0">@scenario.FinancialProjections.Revenue.RevenueModel</p>
                                    </div>
                                    
                                    <h6 class="mt-4">Success Factors</h6>
                                    @foreach (var factor in scenario.SuccessFactors)
                                    {
                                        <div class="alert alert-success py-2">
                                            <i class="fas fa-check-circle me-2"></i>@factor
                                        </div>
                                    }
                                </div>
                                
                                <div class="col-lg-6">
                                    <h5><i class="fas fa-exclamation-triangle text-danger me-2"></i>Risk Analysis</h5>
                                    
                                    <h6>Market Risks</h6>
                                    @foreach (var challenge in scenario.KeyChallenges)
                                    {
                                        <div class="alert alert-warning py-2">
                                            <i class="fas fa-exclamation-triangle me-2"></i>@challenge
                                        </div>
                                    }

                                    <h6 class="mt-4">Competitive Intensity</h6>
                                    <div class="alert alert-info">
                                        <p class="mb-0">@scenario.MarketResearch.Competition.CompetitiveIntensity</p>
                                    </div>

                                    @if (scenario.FinancialProjections.Funding != null && scenario.FinancialProjections.Funding.TotalFundingNeeded > 0)
                                    {
                                        <h6 class="mt-4">Funding Requirements</h6>
                                        <div class="alert alert-primary">
                                            <p class="mb-1"><strong>Total Required:</strong> $@(scenario.FinancialProjections.Funding.TotalFundingNeeded.ToString("N0"))</p>
                                            <p class="mb-0"><strong>Use of Funds:</strong> @scenario.FinancialProjections.Funding.UseOfFunds</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-4 mb-5">
            <div class="col-12 text-center">
                <button class="btn btn-primary me-2" @onclick="CustomizePlan">
                    <i class="fas fa-edit me-2"></i>Customize This Plan
                </button>
                <button class="btn btn-success" @onclick="StartWithIdea">
                    <i class="fas fa-rocket me-2"></i>Start Building This Idea
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ScenarioId { get; set; } = "";
    
    private BusinessIdeaScenario? scenario;
    private string activeTab = "overview";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ScenarioId))
        {
            var allScenarios = await MockDataService.GetAllScenariosAsync();
            scenario = allScenarios.FirstOrDefault(s => s.Id == ScenarioId);
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private void SetOverviewTab() => SetActiveTab("overview");
    private void SetMarketTab() => SetActiveTab("market");
    private void SetFinancialTab() => SetActiveTab("financial");
    private void SetAnalysisTab() => SetActiveTab("analysis");

    private void NavigateToScenarios()
    {
        Navigation.NavigateTo("/scenarios");
    }

    private void CustomizePlan()
    {
        Navigation.NavigateTo($"/plan-editor/{ScenarioId}");
    }

    private void StartWithIdea()
    {
        Navigation.NavigateTo("/idea-input");
    }

    private string GetViabilityColor(int score)
    {
        return score switch
        {
            >= 80 => "success",
            >= 60 => "warning",
            _ => "danger"
        };
    }
}

<style>
    .custom-tabs {
        border-bottom: 2px solid #e9ecef;
        display: flex;
        flex-wrap: nowrap;
        margin-bottom: 0;
    }

    .custom-tabs .nav-item {
        margin-bottom: 0;
        margin-right: 8px;
    }

    .custom-tab {
        border: 1px solid transparent;
        border-radius: 8px 8px 0 0;
        cursor: pointer;
        background: #f8f9fa;
        color: #6c757d;
        font-weight: 500;
        padding: 12px 20px;
        margin-bottom: -2px;
        position: relative;
        transition: all 0.2s ease;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
        display: flex;
        align-items: center;
    }

    .custom-tab:hover {
        background-color: #e9ecef;
        color: #0d6efd;
        border-color: #dee2e6 #dee2e6 transparent;
        transform: translateY(-2px);
    }

    .custom-tab.active {
        color: #0d6efd;
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
        border-bottom-color: #fff;
        font-weight: 600;
        transform: translateY(-2px);
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
    }

    .custom-tab.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: #fff;
    }

    .breadcrumb-item button {
        color: #0d6efd;
        text-decoration: none;
        background: none;
        border: none;
        padding: 0;
        font-size: inherit;
    }

    .breadcrumb-item button:hover {
        color: #0a58ca;
        text-decoration: underline;
    }

    .btn-outline-primary:hover {
        transform: none;
    }

    .card-header-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #dee2e6;
    }

    .back-button {
        color: #0d6efd !important;
        font-size: 16px;
        font-weight: 500;
        background: none;
        border: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 0;
        transition: all 0.2s ease;
    }

    .back-button:hover {
        color: #0a58ca !important;
        text-decoration: none;
        transform: translateX(-2px);
    }

    .back-button:focus {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* Responsive tab styling */
    @@media (max-width: 768px) {
        .custom-tabs {
            flex-wrap: wrap;
            gap: 4px;
        }

        .custom-tabs .nav-item {
            margin-right: 4px;
            margin-bottom: 8px;
        }

        .custom-tab {
            padding: 10px 16px;
            font-size: 14px;
        }
    }

    @@media (max-width: 576px) {
        .custom-tabs {
            flex-direction: column;
        }

        .custom-tabs .nav-item {
            margin-right: 0;
            margin-bottom: 4px;
        }

        .custom-tab {
            border-radius: 6px;
            margin-bottom: 0;
            transform: none !important;
        }

        .custom-tab.active {
            transform: none !important;
        }
    }
</style>