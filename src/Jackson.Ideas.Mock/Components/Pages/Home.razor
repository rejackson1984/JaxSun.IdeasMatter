@page "/"
@inject NavigationManager Navigation

<PageTitle>Ideas Matter - Your AI Business Partner</PageTitle>

<div class="user-friendly-landing">
    <section class="hero-section">
        <div class="container">
            <div class="trust-badge">
                <span class="badge">💡 No Business Experience Required</span>
            </div>
            <h1 class="hero-title">
                We're Your <span class="highlight">AI Business Team</span>
            </h1>
            <p class="hero-subtitle">
                Turn your idea into a real business in <strong>under 30 minutes</strong>. 
                We handle the confusing stuff - you focus on your vision.
            </p>
            
            <div class="simple-process">
                <div class="process-step">
                    <div class="step-icon">💭</div>
                    <h3>Share Your Idea</h3>
                    <p>Tell us like you're telling a friend</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">🤖</div>
                    <h3>We Analyze Everything</h3>
                    <p>Market research, competition, money potential</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">📋</div>
                    <h3>Get Your Business Plan</h3>
                    <p>Clear next steps, no confusing jargon</p>
                </div>
            </div>

            <div class="hero-actions">
                <button class="btn btn-primary btn-main" @onclick="StartDemo">
                    <span>🚀</span>
                    Start With My Idea (It's Free!)
                </button>
            </div>

            <div class="confidence-builders">
                <span>✅ Takes 15-30 minutes</span>
                <span>✅ Plain English, no jargon</span>
                <span>✅ Used by 1,000+ beginners</span>
            </div>
        </div>
    </section>

    <section class="demo-section">
        <div class="container">
            <h2>See What You'll Get</h2>
            <div class="demo-preview">
                <h3>Sample Analysis: "Food Delivery App for College Students"</h3>
                <div class="result-cards">
                    <div class="result-card">
                        <div class="score-badge good">8/10</div>
                        <h4>Business Health Score</h4>
                        <p><strong>Great idea!</strong> There's definitely demand for this.</p>
                    </div>
                    <div class="result-card">
                        <div class="insight-icon">💰</div>
                        <h4>Revenue Potential</h4>
                        <p>Market size: $2.3B annually with 15% growth rate</p>
                    </div>
                    <div class="result-card">
                        <div class="insight-icon">🎯</div>
                        <h4>Target Market</h4>
                        <p>18-24 year olds, busy lifestyle, tech-savvy</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="features-section">
        <div class="container">
            <h2>What Makes Us Different</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🧠</div>
                    <h4>AI-Powered Research</h4>
                    <p>We analyze thousands of data points to give you insights that would take weeks to gather manually.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h4>Real Market Data</h4>
                    <p>Get actual market sizes, competitor analysis, and customer insights - not generic advice.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h4>Fast Results</h4>
                    <p>From idea to business plan in under 30 minutes. No more months of research and analysis.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">✅</div>
                    <h4>Actionable Plans</h4>
                    <p>Get clear next steps and priorities, not just theoretical advice you can't act on.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Ready to Turn Your Idea Into Reality?</h2>
            <p>Join hundreds of entrepreneurs who've already validated their ideas with us.</p>
            <button class="btn btn-primary btn-main" @onclick="StartDemo">
                <span>🚀</span>
                Start Your Free Analysis Now
            </button>
            <div class="trust-indicators">
                <span>⭐⭐⭐⭐⭐ 4.8/5 rating</span>
                <span>🔒 No credit card required</span>
                <span>⚡ Results in 15-30 minutes</span>
            </div>
        </div>
    </section>
</div>

<style>
    .user-friendly-landing {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
    }

    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 80px 20px;
        text-align: center;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .trust-badge .badge {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 700;
        margin: 20px 0;
        line-height: 1.2;
    }

    .hero-title .highlight {
        background: linear-gradient(45deg, #FFD700, #FFA500);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        margin-bottom: 40px;
        opacity: 0.95;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .simple-process {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: 50px 0;
        flex-wrap: wrap;
    }

    .process-step {
        background: rgba(255, 255, 255, 0.1);
        padding: 25px 20px;
        border-radius: 15px;
        min-width: 180px;
        backdrop-filter: blur(10px);
    }

    .step-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .process-step h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 8px 0;
    }

    .process-step p {
        font-size: 0.9rem;
        opacity: 0.9;
        margin: 0;
    }

    .arrow {
        font-size: 2rem;
        font-weight: bold;
        color: #FFD700;
    }

    .btn {
        padding: 15px 30px;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-primary {
        background: #FF6B6B;
        color: white;
        box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
    }

    .btn-primary:hover {
        background: #FF5252;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 107, 0.4);
    }

    .btn-main {
        font-size: 1.2rem;
        padding: 18px 35px;
    }

    .confidence-builders {
        display: flex;
        gap: 30px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
        font-size: 0.95rem;
        opacity: 0.9;
    }

    .demo-section {
        padding: 80px 20px;
        background: #f8f9fa;
        text-align: center;
    }

    .demo-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 40px;
        color: #333;
    }

    .demo-preview {
        background: white;
        border-radius: 15px;
        padding: 40px;
        max-width: 600px;
        margin: 0 auto;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .demo-preview h3 {
        color: #333;
        margin-bottom: 20px;
    }

    .result-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #667eea;
    }

    .score-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 1.2rem;
        margin-bottom: 10px;
    }

    .score-badge.good {
        background: #d4edda;
        color: #155724;
    }

    .result-card h4 {
        margin: 10px 0;
        color: #333;
    }

    .result-card p {
        margin: 0;
        color: #666;
    }

    .result-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .insight-icon {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .features-section {
        padding: 80px 20px;
        background: white;
    }

    .features-section h2 {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 50px;
        color: #333;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .feature-card {
        text-align: center;
        padding: 30px 20px;
        border-radius: 15px;
        background: #f8f9fa;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .feature-card h4 {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 15px 0;
        color: #333;
    }

    .feature-card p {
        color: #666;
        line-height: 1.6;
        margin: 0;
    }

    .cta-section {
        padding: 80px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-align: center;
    }

    .cta-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .cta-section p {
        font-size: 1.2rem;
        margin-bottom: 40px;
        opacity: 0.9;
    }

    .trust-indicators {
        display: flex;
        gap: 30px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
        font-size: 0.95rem;
        opacity: 0.9;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.2rem;
        }
        
        .simple-process {
            flex-direction: column;
            gap: 15px;
        }
        
        .arrow {
            transform: rotate(90deg);
        }
        
        .features-grid {
            grid-template-columns: 1fr;
        }
        
        .result-cards {
            grid-template-columns: 1fr;
        }
        
        .confidence-builders,
        .trust-indicators {
            flex-direction: column;
            gap: 15px;
        }
    }
</style>

@code {
    private void StartDemo()
    {
        Navigation.NavigateTo("/idea-input");
    }
}