@page "/"
@inject NavigationManager Navigation

<PageTitle>Ideas Matter - Your Dream-Enabling Business Partner</PageTitle>

<div class="user-friendly-landing">
    <section class="hero-section">
        <div class="container">
            <div class="trust-badge">
                <span class="badge">💼 You Own It, We Enable It</span>
            </div>
            <h1 class="hero-title">
                Your <span class="highlight">Dream-Enabling</span> Business Partner
            </h1>
            <p class="hero-subtitle">
                We give you the power to turn your idea into a profitable business. 
                <strong>You stay in control</strong> - we provide the tools, expertise, and funding to make your dreams reality.
            </p>
            
            <div class="simple-process">
                <div class="process-step">
                    <div class="step-icon">💭</div>
                    <h3>Share Your Vision</h3>
                    <p>Tell us your dream business idea</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">📋</div>
                    <h3>Build Your Plan</h3>
                    <p>Create your strategy with AI guidance</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">🎨</div>
                    <h3>Design & Create</h3>
                    <p>Build your product with our platform</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">🚀</div>
                    <h3>Launch Together</h3>
                    <p>You lead, we provide the power</p>
                </div>
                <div class="arrow">→</div>
                <div class="process-step">
                    <div class="step-icon">💰</div>
                    <h3>Grow & Profit</h3>
                    <p>Shared success, your control</p>
                </div>
            </div>

            <div class="hero-actions">
                <button class="btn btn-primary btn-main" @onclick="StartDemo">
                    <span>✨</span>
                    Enable My Dream Business
                </button>
            </div>

            <div class="confidence-builders">
                <span>✅ You maintain full ownership and control</span>
                <span>✅ Enterprise tools at startup costs</span>
                <span>✅ We succeed together</span>
            </div>
        </div>
    </section>

    <section class="partnership-section">
        <div class="container">
            <h2>Your Dreams, Our Capabilities</h2>
            <div class="partnership-preview">
                <h3>Why Partner With Ideas Matter?</h3>
                <div class="value-cards">
                    <div class="value-card">
                        <div class="value-icon">🏢</div>
                        <h4>Your Company, Your Control</h4>
                        <p><strong>You make decisions,</strong> we provide enterprise-level capabilities. Full ownership, guided success.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">💡</div>
                        <h4>Impossible Made Possible</h4>
                        <p>What costs $500K+ traditionally, we enable for a small revenue share. Access without the risk.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🤝</div>
                        <h4>We Only Win When You Win</h4>
                        <p>Revenue sharing partnership means we're invested in your success. Your growth is our growth.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="features-section">
        <div class="container">
            <h2>Complete Business Enablement Services</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🔍</div>
                    <h4>Market Intelligence</h4>
                    <p>Enable smart market decisions with AI insights. You understand your customers, we provide the data.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📋</div>
                    <h4>Business Strategy</h4>
                    <p>Build winning plans with guided automation. Your vision, our strategic expertise.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🎨</div>
                    <h4>Product Creation</h4>
                    <p>Design professional products with our platform. You define it, we help you build it.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚒️</div>
                    <h4>Development Power</h4>
                    <p>Build enterprise-grade solutions without coding. Your ideas, our technical capabilities.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🚀</div>
                    <h4>Launch Support</h4>
                    <p>Execute go-to-market with proven automation. You lead the vision, we power the execution.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📈</div>
                    <h4>Marketing Engine</h4>
                    <p>Scale customer acquisition with AI-powered tools. Your brand, our marketing automation.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💰</div>
                    <h4>Sales Acceleration</h4>
                    <p>Convert leads with automated sales systems. You close deals, we handle the pipeline.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🤝</div>
                    <h4>Customer Success</h4>
                    <p>Deliver world-class support without overhead. Your customers, our support platform.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="partnership-model-section">
        <div class="container">
            <h2>How Our Partnership Works</h2>
            <div class="partnership-comparison">
                <div class="comparison-card traditional">
                    <h3>Traditional Startup</h3>
                    <div class="cost-breakdown">
                        <div class="cost-item">
                            <span class="cost-label">Development Team:</span>
                            <span class="cost-amount">$300K+/year</span>
                        </div>
                        <div class="cost-item">
                            <span class="cost-label">Marketing Budget:</span>
                            <span class="cost-amount">$200K+/year</span>
                        </div>
                        <div class="cost-item">
                            <span class="cost-label">Operations Setup:</span>
                            <span class="cost-amount">$150K+</span>
                        </div>
                        <div class="cost-item">
                            <span class="cost-label">Infrastructure:</span>
                            <span class="cost-amount">$50K+/year</span>
                        </div>
                        <div class="total-cost">
                            <strong>Total: $700K+ in Year 1</strong>
                        </div>
                    </div>
                </div>
                
                <div class="vs-divider">
                    <span>VS</span>
                </div>
                
                <div class="comparison-card partnership">
                    <h3>Ideas Matter Partnership</h3>
                    <div class="partnership-benefits">
                        <div class="benefit-item">
                            <span class="benefit-icon">✅</span>
                            <span class="benefit-text">All capabilities included</span>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">✅</span>
                            <span class="benefit-text">No upfront costs</span>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">✅</span>
                            <span class="benefit-text">You maintain full control</span>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">✅</span>
                            <span class="benefit-text">Revenue sharing only</span>
                        </div>
                        <div class="partnership-deal">
                            <strong>Your Investment: Small Revenue Share</strong>
                            <p>We only profit when you profit</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Ready to Make the Impossible Possible?</h2>
            <p>Join entrepreneurs who kept control while accessing enterprise capabilities to make their dreams reality.</p>
            <button class="btn btn-primary btn-main" @onclick="StartDemo">
                <span>✨</span>
                Enable My Dream Business
            </button>
            <div class="trust-indicators">
                <span>✅ You maintain full ownership and control</span>
                <span>💼 Enterprise tools at startup costs</span>
                <span>🤝 We succeed together</span>
            </div>
        </div>
    </section>
</div>

<style>
    .user-friendly-landing {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
    }

    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 80px 20px;
        text-align: center;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .trust-badge .badge {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 700;
        margin: 20px 0;
        line-height: 1.2;
    }

    .hero-title .highlight {
        background: linear-gradient(45deg, #FFD700, #FFA500);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        font-size: 1.2rem;
        margin-bottom: 40px;
        opacity: 0.95;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .simple-process {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin: 50px 0;
        flex-wrap: wrap;
    }

    .process-step {
        background: rgba(255, 255, 255, 0.1);
        padding: 20px 15px;
        border-radius: 15px;
        min-width: 160px;
        backdrop-filter: blur(10px);
    }

    .step-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .process-step h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 8px 0;
    }

    .process-step p {
        font-size: 0.9rem;
        opacity: 0.9;
        margin: 0;
    }

    .arrow {
        font-size: 2rem;
        font-weight: bold;
        color: #FFD700;
    }

    .btn {
        padding: 15px 30px;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-primary {
        background: #FF6B6B;
        color: white;
        box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
    }

    .btn-primary:hover {
        background: #FF5252;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 107, 0.4);
    }

    .btn-main {
        font-size: 1.2rem;
        padding: 18px 35px;
    }

    .confidence-builders {
        display: flex;
        gap: 30px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
        font-size: 0.95rem;
        opacity: 0.9;
    }

    .partnership-section {
        padding: 80px 20px;
        background: #f8f9fa;
        text-align: center;
    }

    .partnership-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 40px;
        color: #333;
    }

    .partnership-preview {
        background: white;
        border-radius: 15px;
        padding: 40px;
        max-width: 800px;
        margin: 0 auto;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .partnership-preview h3 {
        color: #333;
        margin-bottom: 30px;
        font-size: 1.5rem;
    }

    .value-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .value-card {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 10px;
        border-left: 4px solid #667eea;
        text-align: left;
    }

    .value-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        display: block;
    }

    .value-card h4 {
        margin: 10px 0;
        color: #333;
        font-size: 1.2rem;
    }

    .value-card p {
        margin: 0;
        color: #666;
        line-height: 1.6;
    }

    .partnership-model-section {
        padding: 80px 20px;
        background: white;
        text-align: center;
    }

    .partnership-model-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 50px;
        color: #333;
    }

    .partnership-comparison {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 30px;
        max-width: 1000px;
        margin: 0 auto;
        align-items: center;
    }

    .comparison-card {
        background: #f8f9fa;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .comparison-card.traditional {
        border-top: 4px solid #dc3545;
    }

    .comparison-card.partnership {
        border-top: 4px solid #28a745;
        background: #f8fff9;
    }

    .comparison-card h3 {
        margin-bottom: 20px;
        color: #333;
        font-size: 1.4rem;
    }

    .cost-breakdown {
        text-align: left;
    }

    .cost-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #dee2e6;
    }

    .cost-label {
        color: #666;
    }

    .cost-amount {
        color: #dc3545;
        font-weight: 600;
    }

    .total-cost {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 2px solid #dc3545;
        color: #dc3545;
        font-size: 1.1rem;
    }

    .partnership-benefits {
        text-align: left;
    }

    .benefit-item {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
        gap: 12px;
    }

    .benefit-icon {
        color: #28a745;
        font-size: 1.2rem;
    }

    .benefit-text {
        color: #333;
        font-weight: 500;
    }

    .partnership-deal {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 2px solid #28a745;
        color: #28a745;
    }

    .partnership-deal strong {
        font-size: 1.1rem;
        display: block;
        margin-bottom: 5px;
    }

    .partnership-deal p {
        margin: 0;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .vs-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 50%;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .features-section {
        padding: 80px 20px;
        background: white;
    }

    .features-section h2 {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 50px;
        color: #333;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-top: 40px;
    }

    .feature-card {
        text-align: center;
        padding: 30px 20px;
        border-radius: 15px;
        background: #f8f9fa;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .feature-card h4 {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 15px 0;
        color: #333;
    }

    .feature-card p {
        color: #666;
        line-height: 1.6;
        margin: 0;
    }

    .cta-section {
        padding: 80px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-align: center;
    }

    .cta-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .cta-section p {
        font-size: 1.2rem;
        margin-bottom: 40px;
        opacity: 0.9;
    }

    .trust-indicators {
        display: flex;
        gap: 30px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
        font-size: 0.95rem;
        opacity: 0.9;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.2rem;
        }
        
        .simple-process {
            flex-direction: column;
            gap: 15px;
        }
        
        .arrow {
            transform: rotate(90deg);
        }
        
        .features-grid {
            grid-template-columns: 1fr;
        }
        
        .value-cards {
            grid-template-columns: 1fr;
        }
        
        .partnership-comparison {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        .vs-divider {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
        
        .confidence-builders,
        .trust-indicators {
            flex-direction: column;
            gap: 15px;
        }
    }
</style>

@code {
    private void StartDemo()
    {
        Navigation.NavigateTo("/idea-input");
    }
}