@inject NavigationManager Navigation
@inject Jackson.Ideas.Mock.Services.MockAuthenticationStateProvider AuthStateProvider
@inject Jackson.Ideas.Mock.Services.Interfaces.IMockAuthenticationService AuthService

<PageTitle>IdeaCoach Pro - Transform Your Ideas Into Million Dollar Businesses</PageTitle>

<div class="coach-landing">
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <i class="fas fa-rocket brand-icon"></i>
                <span class="brand-text">IdeaCoach Pro</span>
            </div>
            <div class="nav-menu">
                <a href="#home" class="nav-link">Home</a>
                <a href="#journey" class="nav-link">Your Journey</a>
                <a href="#coach" class="nav-link">AI Coach</a>
                <a href="#success" class="nav-link">Success Stories</a>
                <div class="nav-auth">
                    <button class="btn btn-secondary" @onclick="SignIn">Sign In</button>
                    <button class="btn btn-primary" @onclick="StartFreeTrial">Start Free Trial</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-star"></i>
                    <span>Trusted by 50,000+ Entrepreneurs</span>
                </div>
                <h1 class="hero-title">
                    Transform Your <span class="gradient-text">Wild Ideas</span> Into 
                    <span class="gradient-text">Million Dollar Businesses</span>
                </h1>
                <p class="hero-subtitle">
                    Join thousands of first-time entrepreneurs who've built successful companies with our AI-powered coaching platform. 
                    No business experience required - just bring your passion and we'll handle the rest.
                </p>
                <div class="hero-cta">
                    <button class="btn-hero-primary" @onclick="StartDemo">
                        <i class="fas fa-rocket"></i>
                        Start Your Business Journey
                    </button>
                    <button class="btn-hero-secondary" @onclick="WatchDemo">
                        <i class="fas fa-play"></i>
                        Watch 2-Min Demo
                    </button>
                </div>
                <div class="hero-stats">
                    <div class="stat">
                        <div class="stat-number">$2.3B+</div>
                        <div class="stat-label">Generated Revenue</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">15,000+</div>
                        <div class="stat-label">Launched Businesses</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">94%</div>
                        <div class="stat-label">Success Rate</div>
                    </div>
                </div>
            </div>
            <div class="hero-visual">
                <div class="dashboard-preview">
                    <div class="preview-header">
                        <div class="preview-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <div class="preview-title">Your Business Dashboard</div>
                    </div>
                    <div class="preview-content">
                        <div class="coach-message">
                            <div class="coach-avatar">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div class="message-bubble">
                                <p>"Great news! Your market research shows 87% demand for your app idea. Ready to move to the planning phase?"</p>
                            </div>
                        </div>
                        <div class="progress-tracker">
                            <div class="phase active"><span>1</span> Research</div>
                            <div class="phase next"><span>2</span> Planning</div>
                            <div class="phase"><span>3</span> Design</div>
                            <div class="phase"><span>4</span> Development</div>
                            <div class="phase"><span>5</span> Launch</div>
                            <div class="phase"><span>6</span> Operations</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Journey Section -->
    <section id="journey" class="journey">
        <div class="container">
            <div class="section-header">
                <h2>Your Entrepreneurial Journey</h2>
                <p>From idea to IPO - we guide you through every step with personalized AI coaching</p>
            </div>
            
            <div class="journey-timeline">
                <div class="journey-phase">
                    <div class="phase-icon research">
                        <i class="fas fa-search"></i>
                    </div>
                    <div class="phase-content">
                        <h3>1. Research & Validation</h3>
                        <p class="phase-subtitle">Discover if your idea has market potential</p>
                        <ul class="phase-features">
                            <li><i class="fas fa-check"></i> AI-powered market analysis</li>
                            <li><i class="fas fa-check"></i> Competitor landscape mapping</li>
                            <li><i class="fas fa-check"></i> Customer persona development</li>
                            <li><i class="fas fa-check"></i> Revenue opportunity assessment</li>
                        </ul>
                        <div class="coach-insight">
                            <div class="coach-avatar-small">
                                <i class="fas fa-robot"></i>
                            </div>
                            <p>"I'll analyze 50,000+ data points to validate your idea's potential"</p>
                        </div>
                    </div>
                </div>

                <div class="journey-phase">
                    <div class="phase-icon planning">
                        <i class="fas fa-clipboard-list"></i>
                    </div>
                    <div class="phase-content">
                        <h3>2. Strategic Planning</h3>
                        <p class="phase-subtitle">Build your roadmap to success</p>
                        <ul class="phase-features">
                            <li><i class="fas fa-check"></i> Business model optimization</li>
                            <li><i class="fas fa-check"></i> Financial projections & budgeting</li>
                            <li><i class="fas fa-check"></i> Go-to-market strategy</li>
                            <li><i class="fas fa-check"></i> Risk assessment & mitigation</li>
                        </ul>
                        <div class="coach-insight">
                            <div class="coach-avatar-small">
                                <i class="fas fa-robot"></i>
                            </div>
                            <p>"I'll create a custom business plan that investors love"</p>
                        </div>
                    </div>
                </div>

                <div class="journey-phase">
                    <div class="phase-icon design">
                        <i class="fas fa-palette"></i>
                    </div>
                    <div class="phase-content">
                        <h3>3. Design & Prototyping</h3>
                        <p class="phase-subtitle">Create stunning user experiences</p>
                        <ul class="phase-features">
                            <li><i class="fas fa-check"></i> Brand identity development</li>
                            <li><i class="fas fa-check"></i> UI/UX design automation</li>
                            <li><i class="fas fa-check"></i> Interactive prototypes</li>
                            <li><i class="fas fa-check"></i> User testing & feedback</li>
                        </ul>
                        <div class="coach-insight">
                            <div class="coach-avatar-small">
                                <i class="fas fa-robot"></i>
                            </div>
                            <p>"I'll design like the world's best agencies, but faster and cheaper"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Coach Section -->
    <section id="coach" class="coach-section">
        <div class="container">
            <div class="coach-hero">
                <div class="coach-content">
                    <h2>Meet Your AI Business Coach</h2>
                    <p class="coach-subtitle">
                        More than just AI - your personal mentor with the combined knowledge of 
                        10,000+ successful entrepreneurs, VCs, and business experts.
                    </p>
                    
                    <div class="coach-features">
                        <div class="coach-feature">
                            <div class="feature-icon">
                                <i class="fas fa-brain"></i>
                            </div>
                            <div class="feature-content">
                                <h4>Learns Your Style</h4>
                                <p>Adapts to your personality, goals, and learning preferences</p>
                            </div>
                        </div>
                        
                        <div class="coach-feature">
                            <div class="feature-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="feature-content">
                                <h4>24/7 Availability</h4>
                                <p>Always there when you need guidance, day or night</p>
                            </div>
                        </div>
                        
                        <div class="coach-feature">
                            <div class="feature-icon">
                                <i class="fas fa-target"></i>
                            </div>
                            <div class="feature-content">
                                <h4>Results-Driven</h4>
                                <p>Focused on your success with proven methodologies</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="coach-demo">
                    <div class="chat-interface">
                        <div class="chat-header">
                            <div class="coach-status">
                                <div class="status-dot online"></div>
                                <span>Coach Alex - Online</span>
                            </div>
                        </div>
                        <div class="chat-messages">
                            <div class="message coach-message">
                                <div class="message-avatar">
                                    <i class="fas fa-robot"></i>
                                </div>
                                <div class="message-content">
                                    <p>Hey! I've analyzed your fitness app idea. The market looks promising - $4.4B industry with 73% growth. Ready to dive into your business plan?</p>
                                </div>
                            </div>
                        </div>
                        <div class="chat-input">
                            <input type="text" placeholder="Ask your coach anything...">
                            <button><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>Ready to Build Your Dream Business?</h2>
                <p>Join 50,000+ entrepreneurs who've transformed their ideas into successful companies</p>
                <div class="cta-buttons">
                    <button class="btn-cta-primary" @onclick="StartFreeTrial">
                        <i class="fas fa-rocket"></i>
                        Start Your Free Trial
                    </button>
                    <button class="btn-cta-secondary" @onclick="BookDemo">
                        <i class="fas fa-calendar"></i>
                        Book a Demo Call
                    </button>
                </div>
                <div class="cta-trust">
                    <div class="trust-item">
                        <i class="fas fa-lock"></i>
                        <span>No credit card required</span>
                    </div>
                    <div class="trust-item">
                        <i class="fas fa-clock"></i>
                        <span>Setup in 5 minutes</span>
                    </div>
                    <div class="trust-item">
                        <i class="fas fa-times"></i>
                        <span>Cancel anytime</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


@code {
    private async Task StartDemo()
    {
        await AutoLoginAndNavigate();
    }
    
    private async Task SignIn()
    {
        await AutoLoginAndNavigate();
    }
    
    private async Task StartFreeTrial()
    {
        await AutoLoginAndNavigate();
    }
    
    private async Task AutoLoginAndNavigate()
    {
        // In development mode, automatically log in with demo user
        var demoUser = await AuthService.GetUserByEmailAsync("demo@ideasmatter.com");
        if (demoUser != null)
        {
            await AuthStateProvider.LoginAsync(demoUser);
        }
        
        // Use forceLoad to ensure proper page refresh
        Navigation.NavigateTo("/dashboard", forceLoad: true);
    }
    
    private void WatchDemo()
    {
        Navigation.NavigateTo("/hub-demo");
    }
    
    private void BookDemo()
    {
        Navigation.NavigateTo("/hub-demo");
    }
}