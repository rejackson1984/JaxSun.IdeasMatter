@page "/test-dashboard"
@layout HubLayout

<PageTitle>Test Dashboard - IdeaCoach Pro</PageTitle>

<div class="test-dashboard">
    <h1>🔴 TEST DASHBOARD WORKS!</h1>
    <p>This is a simple test dashboard without service dependencies.</p>
    <p>Current time: @DateTime.Now</p>
    
    <div class="test-content">
        <h2>Dashboard Content Test</h2>
        <div class="stat-grid">
            <div class="stat-card">
                <h3>Test Stat 1</h3>
                <p>Value: 42</p>
            </div>
            <div class="stat-card">
                <h3>Test Stat 2</h3>
                <p>Value: 99</p>
            </div>
        </div>
    </div>
</div>

<style>
    .test-dashboard {
        padding: 2rem;
        background: white;
        border-radius: 8px;
        margin: 1rem;
    }
    
    .test-dashboard h1 {
        color: red;
        font-size: 2rem;
        margin-bottom: 1rem;
    }
    
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 2rem;
    }
    
    .stat-card {
        background: #f0f8ff;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
    }
</style>