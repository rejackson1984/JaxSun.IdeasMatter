@page "/business-model-canvas"
@page "/business-model-canvas/{CanvasId}"
@layout HubLayout
@using Jackson.Ideas.Mock.Services.Interfaces
@using Jackson.Ideas.Mock.Models
@inject IBusinessModelCanvasService CanvasService
@inject ICoachPersonaService CoachPersonaService
@inject IHubContextService HubContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Business Model Canvas - Strategic Planning Hub</PageTitle>

<div class="canvas-container">
    @if (_canvas != null && _currentCoach != null)
    {
        <!-- Strategy Coach Header -->
        <div class="coach-header-section hub-planning-theme">
            <div class="coach-header-content">
                <div class="coach-avatar-header">
                    <i class="@_currentCoach.Avatar"></i>
                </div>
                <div class="header-text-content">
                    <h1 class="coach-header-title">Business Model Canvas 🎯</h1>
                    <p class="coach-header-message">@GetCoachHeaderMessage()</p>
                    <div class="canvas-progress-indicator">
                        <div class="progress-circle-small">
                            <span class="progress-value">@_completenessScore%</span>
                        </div>
                        <span class="progress-label">Canvas Completeness</span>
                    </div>
                </div>
                <div class="canvas-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="ShowTemplates">
                        <i class="fas fa-layer-group"></i>
                        Templates
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="ExportCanvas">
                        <i class="fas fa-download"></i>
                        Export
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="StartCollaboration">
                        <i class="fas fa-users"></i>
                        Collaborate
                    </button>
                </div>
            </div>
        </div>

        <!-- Business Model Canvas Grid -->
        <div class="canvas-grid">
            <!-- Key Partners -->
            <div class="canvas-section section-partners" data-section="keypartners">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-handshake section-icon"></i>
                        Key Partners
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("KeyPartners")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        Who are our key partners and suppliers?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.KeyPartners)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("KeyPartners", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Key Activities -->
            <div class="canvas-section section-activities" data-section="keyactivities">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-cogs section-icon"></i>
                        Key Activities
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("KeyActivities")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        What key activities does our value proposition require?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.KeyActivities)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("KeyActivities", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Key Resources -->
            <div class="canvas-section section-resources" data-section="keyresources">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-cube section-icon"></i>
                        Key Resources
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("KeyResources")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        What key resources does our value proposition require?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.KeyResources)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("KeyResources", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Value Propositions -->
            <div class="canvas-section section-value-prop" data-section="valuepropositions">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-star section-icon"></i>
                        Value Propositions
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("ValuePropositions")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content highlight-center">
                    <div class="section-description">
                        What value do we deliver to customers?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.ValuePropositions)
                        {
                            <div class="canvas-item value-prop-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("ValuePropositions", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Customer Relationships -->
            <div class="canvas-section section-relationships" data-section="customerrelationships">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-heart section-icon"></i>
                        Customer Relationships
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("CustomerRelationships")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        What type of relationship do we establish with customers?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.CustomerRelationships)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("CustomerRelationships", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Channels -->
            <div class="canvas-section section-channels" data-section="channels">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-route section-icon"></i>
                        Channels
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("Channels")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        Through which channels do we reach customers?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.Channels)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("Channels", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Customer Segments -->
            <div class="canvas-section section-segments" data-section="customersegments">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-users section-icon"></i>
                        Customer Segments
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("CustomerSegments")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        For whom are we creating value?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.CustomerSegments)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("CustomerSegments", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Cost Structure -->
            <div class="canvas-section section-costs" data-section="coststructure">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-coins section-icon"></i>
                        Cost Structure
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("CostStructure")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        What are the most important costs in our business model?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.CostStructure)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("CostStructure", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Revenue Streams -->
            <div class="canvas-section section-revenue" data-section="revenuestreams">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="fas fa-dollar-sign section-icon"></i>
                        Revenue Streams
                    </h3>
                    <button class="btn-add-item" @onclick='() => OpenAddDialog("RevenueStreams")'>
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="section-content">
                    <div class="section-description">
                        For what value are customers willing to pay?
                    </div>
                    <div class="items-container">
                        @foreach (var item in _canvas.RevenueStreams)
                        {
                            <div class="canvas-item" draggable="true">
                                <span class="item-text">@item</span>
                                <button class="btn-remove-item" @onclick='() => RemoveItem("RevenueStreams", item)'>
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Canvas Insights Panel -->
        @if (_insights != null && _insights.Any())
        {
            <div class="insights-panel">
                <h2 class="insights-title">
                    <i class="fas fa-lightbulb"></i>
                    Strategic Insights from @_currentCoach.Name
                </h2>
                <div class="insights-grid">
                    @foreach (var insight in _insights.Take(3))
                    {
                        <div class="insight-card insight-@insight.Type.ToLower()">
                            <div class="insight-header">
                                <span class="insight-type @GetInsightTypeClass(insight.Type)">@insight.Type</span>
                                <span class="insight-priority">Priority @insight.Priority</span>
                            </div>
                            <h4 class="insight-title">@insight.Title</h4>
                            <p class="insight-description">@insight.Description</p>
                            <div class="insight-action">
                                <strong>Action:</strong> @insight.ActionItem
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Add Item Modal -->
        @if (_showAddDialog)
        {
            <div class="modal-overlay" @onclick="CloseAddDialog">
                <div class="add-item-modal" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>Add to @_currentSection</h3>
                        <button class="btn-close" @onclick="CloseAddDialog">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-content">
                        <textarea @bind="_newItemText" placeholder="Enter your item..." class="item-input" rows="3"></textarea>
                        <div class="modal-actions">
                            <button class="btn btn-secondary" @onclick="CloseAddDialog">Cancel</button>
                            <button class="btn btn-primary" @onclick="AddNewItem" disabled="@string.IsNullOrWhiteSpace(_newItemText)">
                                <i class="fas fa-plus"></i>
                                Add Item
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (_isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner"></div>
            <h2>Loading Your Business Model Canvas...</h2>
            <p>Our Strategy coach is preparing your strategic framework</p>
        </div>
    }
    else
    {
        <div class="error-state">
            <i class="fas fa-exclamation-triangle"></i>
            <h2>Canvas Not Found</h2>
            <p>We couldn't find the requested business model canvas.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/business-plan-builder")'>
                <i class="fas fa-arrow-left"></i>
                Return to Business Planning
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? CanvasId { get; set; }
    
    private Models.BusinessModelCanvas? _canvas;
    private CoachPersona? _currentCoach;
    private List<CanvasInsight>? _insights;
    private bool _isLoading = true;
    private bool _showAddDialog = false;
    private string _currentSection = "";
    private string _newItemText = "";
    private int _completenessScore = 0;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadCanvasData();
        _currentCoach = await CoachPersonaService.GetCoachForHubAsync(BusinessHub.BusinessPlanning);
        _isLoading = false;
        StateHasChanged();
    }
    
    private async Task LoadCanvasData()
    {
        var canvasId = CanvasId ?? "demo-canvas";
        _canvas = await CanvasService.GetCanvasAsync(canvasId);
        
        if (_canvas != null)
        {
            _insights = await CanvasService.GetCanvasInsightsAsync(_canvas.Id);
            var validation = await CanvasService.ValidateCanvasAsync(_canvas.Id);
            _completenessScore = validation.CompletenessScore;
        }
    }
    
    private string GetCoachHeaderMessage()
    {
        if (_currentCoach == null || _canvas == null) return "";
        
        return _completenessScore >= 80 
            ? $"Excellent strategic framework! Your business model is well-defined and ready for execution. {_currentCoach.Name} has identified key optimization opportunities."
            : _completenessScore >= 60
            ? $"Strong progress! {_currentCoach.Name} will help you refine the remaining sections for a comprehensive business model."
            : $"Let's build your business model together. {_currentCoach.Name} will guide you through each section systematically.";
    }
    
    private void OpenAddDialog(string section)
    {
        _currentSection = section;
        _newItemText = "";
        _showAddDialog = true;
    }
    
    private void CloseAddDialog()
    {
        _showAddDialog = false;
        _currentSection = "";
        _newItemText = "";
    }
    
    private async Task AddNewItem()
    {
        if (string.IsNullOrWhiteSpace(_newItemText) || _canvas == null) return;
        
        var items = GetSectionItems(_currentSection).ToList();
        items.Add(_newItemText.Trim());
        
        await UpdateCanvasSection(_currentSection, items);
        CloseAddDialog();
    }
    
    private async Task RemoveItem(string section, string item)
    {
        if (_canvas == null) return;
        
        var items = GetSectionItems(section).ToList();
        items.Remove(item);
        
        await UpdateCanvasSection(section, items);
    }
    
    private async Task UpdateCanvasSection(string section, List<string> items)
    {
        if (_canvas == null) return;
        
        _canvas = await CanvasService.UpdateCanvasSectionAsync(_canvas.Id, section, items);
        
        // Recalculate completeness score
        var validation = await CanvasService.ValidateCanvasAsync(_canvas.Id);
        _completenessScore = validation.CompletenessScore;
        
        StateHasChanged();
    }
    
    private IEnumerable<string> GetSectionItems(string section)
    {
        if (_canvas == null) return new List<string>();
        
        return section switch
        {
            "KeyPartners" => _canvas.KeyPartners,
            "KeyActivities" => _canvas.KeyActivities,
            "KeyResources" => _canvas.KeyResources,
            "ValuePropositions" => _canvas.ValuePropositions,
            "CustomerRelationships" => _canvas.CustomerRelationships,
            "Channels" => _canvas.Channels,
            "CustomerSegments" => _canvas.CustomerSegments,
            "CostStructure" => _canvas.CostStructure,
            "RevenueStreams" => _canvas.RevenueStreams,
            _ => new List<string>()
        };
    }
    
    private string GetInsightTypeClass(string type)
    {
        return type.ToLower() switch
        {
            "strength" => "type-strength",
            "weakness" => "type-weakness",
            "opportunity" => "type-opportunity",
            "threat" => "type-threat",
            "recommendation" => "type-recommendation",
            _ => "type-default"
        };
    }
    
    private async Task ShowTemplates()
    {
        // TODO: Show template selection modal
        await JSRuntime.InvokeVoidAsync("alert", "Template selection coming soon!");
    }
    
    private async Task ExportCanvas()
    {
        if (_canvas != null)
        {
            var export = await CanvasService.ExportCanvasAsync(_canvas.Id, ExportFormat.PDF);
            await JSRuntime.InvokeVoidAsync("alert", "Canvas exported successfully!");
        }
    }
    
    private async Task StartCollaboration()
    {
        if (_canvas != null)
        {
            var session = await CanvasService.CreateCollaborationSessionAsync(_canvas.Id);
            await JSRuntime.InvokeVoidAsync("alert", $"Collaboration started! Share link: {session.ShareLink}");
        }
    }
    
    public void Dispose()
    {
        // No subscriptions to dispose in this component
    }
}

<style>
    .canvas-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem;
        background: var(--hub-background, #f8fafc);
    }

    /* Coach Header */
    .coach-header-section {
        margin-bottom: 2rem;
        border-radius: 1rem;
        overflow: hidden;
    }

    .hub-planning-theme {
        background: linear-gradient(135deg, var(--hub-primary, #5a6fd8) 0%, var(--hub-secondary, #3b82f6) 100%);
        color: white;
    }

    .coach-header-content {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 2rem;
    }

    .coach-avatar-header {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .header-text-content {
        flex: 1;
    }

    .coach-header-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .coach-header-message {
        font-size: 1.125rem;
        margin-bottom: 1rem;
        opacity: 0.95;
        line-height: 1.6;
    }

    .canvas-progress-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .progress-circle-small {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .progress-value {
        font-size: 0.875rem;
    }

    .progress-label {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    .canvas-actions {
        display: flex;
        gap: 0.75rem;
    }

    /* Canvas Grid */
    .canvas-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 1.5rem;
        min-height: 600px;
        margin-bottom: 3rem;
    }

    .canvas-section {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        border: 2px solid #e5e7eb;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .canvas-section:hover {
        border-color: var(--hub-primary, #5a6fd8);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    /* Section positioning */
    .section-partners { grid-column: 1; grid-row: 1; }
    .section-activities { grid-column: 2; grid-row: 1; }
    .section-resources { grid-column: 3; grid-row: 1; }
    .section-value-prop { grid-column: 4; grid-row: 1 / 3; }
    .section-relationships { grid-column: 5; grid-row: 1; }
    .section-channels { grid-column: 5; grid-row: 2; }
    .section-segments { grid-column: 5; grid-row: 1; }
    .section-costs { grid-column: 1 / 3; grid-row: 2; }
    .section-revenue { grid-column: 3 / 5; grid-row: 2; }

    /* Value proposition highlighting */
    .section-value-prop {
        border-color: var(--hub-primary, #5a6fd8);
        background: linear-gradient(135deg, rgba(90, 111, 216, 0.05), rgba(59, 130, 246, 0.05));
    }

    .highlight-center {
        border-width: 3px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid #e2e8f0;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        color: #374151;
        margin: 0;
    }

    .section-icon {
        color: var(--hub-primary, #5a6fd8);
    }

    .btn-add-item {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--hub-primary, #5a6fd8);
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        opacity: 0.7;
        transition: opacity 0.3s ease;
    }

    .btn-add-item:hover {
        opacity: 1;
    }

    .section-content {
        flex: 1;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .section-description {
        font-size: 0.875rem;
        color: #64748b;
        font-style: italic;
        margin-bottom: 0.5rem;
    }

    .items-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .canvas-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        padding: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: move;
        transition: all 0.3s ease;
        position: relative;
    }

    .canvas-item:hover {
        background: #f1f5f9;
        border-color: var(--hub-primary, #5a6fd8);
        transform: translateY(-1px);
    }

    .value-prop-item {
        background: linear-gradient(135deg, rgba(90, 111, 216, 0.1), rgba(59, 130, 246, 0.1));
        border-color: var(--hub-primary, #5a6fd8);
        font-weight: 600;
    }

    .item-text {
        flex: 1;
        font-size: 0.875rem;
        line-height: 1.4;
        color: #374151;
    }

    .btn-remove-item {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #ef4444;
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.75rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .canvas-item:hover .btn-remove-item {
        opacity: 1;
    }

    /* Insights Panel */
    .insights-panel {
        margin-bottom: 3rem;
    }

    .insights-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a202c;
