@layout HubLayout
@using Jackson.Ideas.Mock.Models
@using Jackson.Ideas.Mock.Services.Interfaces
@inject IHubContextService HubContextService
@inject ICoachPersonaService CoachPersonaService
@inject IBusinessPlanBuilderService BusinessPlanBuilderService
@inject IBusinessModelCanvasService BusinessModelCanvasService
@inject ISolutionDesignService SolutionDesignService
@inject NavigationManager Navigation
@implements IDisposable

<!-- Hub 2: Business Planning & Solution Development Dashboard -->
<div class="business-planning-dashboard">
    
    <!-- Strategy Coach Welcome Section -->
    <div class="coach-welcome-section hub-planning-theme">
        <div class="coach-welcome-content">
            <div class="coach-avatar-large hub-planning-avatar">
                <i class="@(_currentCoach?.Avatar ?? "fas fa-chess-board")"></i>
            </div>
            <div class="welcome-text-content">
                <h1 class="coach-welcome-title">Business Planning Hub 📋</h1>
                <p class="coach-message-text">@GetCoachWelcomeMessage()</p>
                <div class="coach-guidance">
                    <div class="guidance-item">
                        <i class="fas fa-chart-pie"></i>
                        <span>Build comprehensive business models</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-calculator"></i>
                        <span>Create detailed financial projections</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-drafting-compass"></i>
                        <span>Design technical architecture</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        
        <!-- Planning Progress Overview -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="section-header">
                    <h2>📊 Planning Progress</h2>
                    <p>Transform your validated idea into a comprehensive business plan</p>
                </div>
            </div>
        </div>

        <!-- Planning Metrics -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="metric-card business-model">
                    <div class="metric-icon">🏗️</div>
                    <div class="metric-value">@_businessModelProgress%</div>
                    <div class="metric-label">Business Model</div>
                    <div class="metric-status">@GetModelStatus()</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card financial">
                    <div class="metric-icon">💰</div>
                    <div class="metric-value">@_financialProgress%</div>
                    <div class="metric-label">Financial Plan</div>
                    <div class="metric-status">@GetFinancialStatus()</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card technical">
                    <div class="metric-icon">⚙️</div>
                    <div class="metric-value">@_technicalProgress%</div>
                    <div class="metric-label">Technical Design</div>
                    <div class="metric-status">@GetTechnicalStatus()</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-card roadmap">
                    <div class="metric-icon">🗺️</div>
                    <div class="metric-value">@_roadmapProgress%</div>
                    <div class="metric-label">Development Plan</div>
                    <div class="metric-status">@GetRoadmapStatus()</div>
                </div>
            </div>
        </div>

        <!-- Current Focus & Strategic Overview -->
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="strategic-overview-card">
                    <div class="card-header">
                        <h3>🎯 Current Focus: MyFitnessPal Clone</h3>
                        <div class="plan-status">
                            <span class="status-badge developing">In Development</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="business-overview">
                            <p class="business-summary">
                                Comprehensive fitness tracking platform with AI-powered nutrition recommendations and social features.
                            </p>
                            <div class="key-metrics-grid">
                                <div class="key-metric">
                                    <span class="metric-title">Target Market</span>
                                    <span class="metric-value">2.1M users</span>
                                </div>
                                <div class="key-metric">
                                    <span class="metric-title">Revenue Target (Y1)</span>
                                    <span class="metric-value">$1.2M</span>
                                </div>
                                <div class="key-metric">
                                    <span class="metric-title">Break-even</span>
                                    <span class="metric-value">Month 18</span>
                                </div>
                                <div class="key-metric">
                                    <span class="metric-title">Investment Need</span>
                                    <span class="metric-value">$350K</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="planning-phases">
                            <h4>Planning Phases</h4>
                            <div class="phases-grid">
                                <div class="phase-item completed">
                                    <i class="fas fa-check"></i>
                                    <span>Market Validation</span>
                                    <div class="phase-score">89%</div>
                                </div>
                                <div class="phase-item active">
                                    <i class="fas fa-clock"></i>
                                    <span>Business Model Canvas</span>
                                    <div class="phase-score">75%</div>
                                </div>
                                <div class="phase-item active">
                                    <i class="fas fa-clock"></i>
                                    <span>Financial Projections</span>
                                    <div class="phase-score">60%</div>
                                </div>
                                <div class="phase-item pending">
                                    <i class="fas fa-clock"></i>
                                    <span>Solution Architecture</span>
                                    <div class="phase-score">25%</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="planning-actions">
                            <button class="btn btn-primary" @onclick="ContinuePlanning">
                                <i class="fas fa-play"></i>
                                Continue Planning
                            </button>
                            <button class="btn btn-outline-primary" @onclick="ViewBusinessPlan">
                                <i class="fas fa-file-alt"></i>
                                View Business Plan
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="strategic-insights-card">
                    <div class="card-header">
                        <h3>📈 Strategic Insights</h3>
                    </div>
                    <div class="card-body">
                        <div class="insight-item">
                            <div class="insight-icon positive">✅</div>
                            <div class="insight-content">
                                <h4>Strong Foundation</h4>
                                <p>Validated market demand provides solid planning base</p>
                            </div>
                        </div>
                        <div class="insight-item">
                            <div class="insight-icon focus">🎯</div>
                            <div class="insight-content">
                                <h4>Focus Area</h4>
                                <p>Complete financial projections to define funding needs</p>
                            </div>
                        </div>
                        <div class="insight-item">
                            <div class="insight-icon recommendation">💡</div>
                            <div class="insight-content">
                                <h4>Next Steps</h4>
                                <p>Ready for technical architecture planning phase</p>
                            </div>
                        </div>
                        <div class="insight-item">
                            <div class="insight-icon warning">⚠️</div>
                            <div class="insight-content">
                                <h4>Risk Factor</h4>
                                <p>Competitive market - ensure unique value proposition</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Planning Tools & Templates -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="planning-tool-card">
                    <div class="tool-header">
                        <div class="tool-icon">🏗️</div>
                        <h4>Business Model Canvas</h4>
                        <div class="tool-progress">75%</div>
                    </div>
                    <div class="tool-content">
                        <p>Define your business model with the proven canvas framework</p>
                        <div class="canvas-sections">
                            <div class="canvas-section completed">✅ Value Propositions</div>
                            <div class="canvas-section completed">✅ Customer Segments</div>
                            <div class="canvas-section completed">✅ Revenue Streams</div>
                            <div class="canvas-section pending">⏳ Key Partnerships</div>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="OpenBusinessModelCanvas">
                            Continue Canvas
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="planning-tool-card">
                    <div class="tool-header">
                        <div class="tool-icon">💰</div>
                        <h4>Financial Projections</h4>
                        <div class="tool-progress">60%</div>
                    </div>
                    <div class="tool-content">
                        <p>Create detailed financial forecasts and funding requirements</p>
                        <div class="financial-highlights">
                            <div class="financial-item">
                                <span class="label">Revenue (Y1)</span>
                                <span class="value">$1.2M</span>
                            </div>
                            <div class="financial-item">
                                <span class="label">Break-even</span>
                                <span class="value">Month 18</span>
                            </div>
                            <div class="financial-item">
                                <span class="label">Funding Need</span>
                                <span class="value">$350K</span>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="OpenFinancialProjections">
                            Continue Projections
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="planning-tool-card">
                    <div class="tool-header">
                        <div class="tool-icon">⚙️</div>
                        <h4>Solution Design</h4>
                        <div class="tool-progress">25%</div>
                    </div>
                    <div class="tool-content">
                        <p>Design technical architecture and development roadmap</p>
                        <div class="design-components">
                            <div class="design-item pending">⏳ System Architecture</div>
                            <div class="design-item pending">⏳ Technology Stack</div>
                            <div class="design-item pending">⏳ Development Phases</div>
                            <div class="design-item pending">⏳ Resource Planning</div>
                        </div>
                        <button class="btn btn-outline-primary w-100" @onclick="OpenSolutionDesign">
                            Start Design
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Business Plan Builder -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="business-plan-builder-card">
                    <div class="card-header">
                        <h3>📄 Business Plan Builder</h3>
                        <div class="plan-completion">
                            <span class="completion-text">68% Complete</span>
                            <div class="completion-bar">
                                <div class="completion-fill" style="width: 68%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="plan-sections-grid">
                            <div class="plan-section completed">
                                <div class="section-header">
                                    <i class="fas fa-check section-icon"></i>
                                    <span class="section-name">Executive Summary</span>
                                    <span class="section-status">Complete</span>
                                </div>
                                <p class="section-description">Overview and key highlights of your business</p>
                            </div>
                            <div class="plan-section completed">
                                <div class="section-header">
                                    <i class="fas fa-check section-icon"></i>
                                    <span class="section-name">Market Analysis</span>
                                    <span class="section-status">Complete</span>
                                </div>
                                <p class="section-description">Target market and competitive landscape</p>
                            </div>
                            <div class="plan-section active">
                                <div class="section-header">
                                    <i class="fas fa-edit section-icon"></i>
                                    <span class="section-name">Financial Projections</span>
                                    <span class="section-status">In Progress</span>
                                </div>
                                <p class="section-description">Revenue forecasts and funding requirements</p>
                            </div>
                            <div class="plan-section pending">
                                <div class="section-header">
                                    <i class="fas fa-clock section-icon"></i>
                                    <span class="section-name">Operations Plan</span>
                                    <span class="section-status">Pending</span>
                                </div>
                                <p class="section-description">Day-to-day operations and processes</p>
                            </div>
                            <div class="plan-section pending">
                                <div class="section-header">
                                    <i class="fas fa-clock section-icon"></i>
                                    <span class="section-name">Marketing Strategy</span>
                                    <span class="section-status">Pending</span>
                                </div>
                                <p class="section-description">Customer acquisition and growth plans</p>
                            </div>
                            <div class="plan-section pending">
                                <div class="section-header">
                                    <i class="fas fa-clock section-icon"></i>
                                    <span class="section-name">Risk Assessment</span>
                                    <span class="section-status">Pending</span>
                                </div>
                                <p class="section-description">Potential risks and mitigation strategies</p>
                            </div>
                        </div>
                        <div class="plan-actions">
                            <button class="btn btn-primary" @onclick="OpenBusinessPlanBuilder">
                                <i class="fas fa-edit"></i>
                                Continue Building Plan
                            </button>
                            <button class="btn btn-outline-primary" @onclick="PreviewBusinessPlan">
                                <i class="fas fa-eye"></i>
                                Preview Plan
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ExportBusinessPlan">
                                <i class="fas fa-download"></i>
                                Export PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private HubContext? _currentContext;
    private CoachPersona? _currentCoach;
    private string _currentCoachMessage = "";
    
    // Dashboard metrics
    private int _businessModelProgress = 75;
    private int _financialProgress = 60;
    private int _technicalProgress = 25;
    private int _roadmapProgress = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlanningData();
        
        // Subscribe to hub context changes
        HubContextService.ContextChanged += OnHubContextChanged;
    }

    private async Task LoadPlanningData()
    {
        _currentContext = await HubContextService.GetCurrentContextAsync();
        
        if (_currentContext != null)
        {
            _currentCoach = await CoachPersonaService.GetCoachForHubAsync(_currentContext.CurrentHub);
            
            // Get coaching message for business planning context
            var coachingContext = new CoachingContext
            {
                CurrentHub = _currentContext.CurrentHub,
                UserProgress = _currentContext.Progress.GetValueOrDefault(_currentContext.CurrentHub)?.CompletionPercentage ?? 0,
                CompletedMilestones = _currentContext.Progress.GetValueOrDefault(_currentContext.CurrentHub)?.CompletedMilestones ?? new List<string>(),
                IsFirstTimeInHub = false
            };
            
            _currentCoachMessage = await CoachPersonaService.GetCoachMessageAsync(_currentContext.CurrentHub, coachingContext);
        }
    }

    private void OnHubContextChanged(object? sender, HubContextChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            await LoadPlanningData();
            StateHasChanged();
        });
    }

    private string GetCoachWelcomeMessage()
    {
        if (_currentCoach != null)
        {
            return _currentCoach.ContextualMessages.GetValueOrDefault("planning_dashboard", _currentCoachMessage);
        }
        return "Welcome to your Business Planning Hub! Let's transform your validated idea into a comprehensive business strategy.";
    }

    private string GetModelStatus() => _businessModelProgress >= 80 ? "Complete" : _businessModelProgress >= 50 ? "In Progress" : "Starting";
    private string GetFinancialStatus() => _financialProgress >= 80 ? "Complete" : _financialProgress >= 50 ? "In Progress" : "Starting";
    private string GetTechnicalStatus() => _technicalProgress >= 80 ? "Complete" : _technicalProgress >= 50 ? "In Progress" : "Not Started";
    private string GetRoadmapStatus() => _roadmapProgress >= 80 ? "Complete" : _roadmapProgress >= 50 ? "In Progress" : "Not Started";

    private void ContinuePlanning()
    {
        Navigation.NavigateTo("/business-plan-builder");
    }

    private void ViewBusinessPlan()
    {
        Navigation.NavigateTo("/business-plan-preview");
    }

    private void OpenBusinessModelCanvas()
    {
        Navigation.NavigateTo("/business-model-canvas");
    }

    private void OpenFinancialProjections()
    {
        Navigation.NavigateTo("/financial-projections");
    }

    private void OpenSolutionDesign()
    {
        Navigation.NavigateTo("/solution-design");
    }

    private void OpenBusinessPlanBuilder()
    {
        Navigation.NavigateTo("/business-plan-builder");
    }

    private void PreviewBusinessPlan()
    {
        Navigation.NavigateTo("/business-plan-preview");
    }

    private void ExportBusinessPlan()
    {
        // Handle PDF export
    }

    public void Dispose()
    {
        if (HubContextService != null)
        {
            HubContextService.ContextChanged -= OnHubContextChanged;
        }
    }
}

<style>
