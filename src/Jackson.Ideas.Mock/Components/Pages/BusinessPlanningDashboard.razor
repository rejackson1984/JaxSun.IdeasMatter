        color: #1e293b;
        margin-bottom: 0.25rem;
    }

    .metric-label {
        color: #64748b;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .metric-status {
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
