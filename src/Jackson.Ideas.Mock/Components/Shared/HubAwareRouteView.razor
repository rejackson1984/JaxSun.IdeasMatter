@using Jackson.Ideas.Mock.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using System.Reflection
@inherits ComponentBase

@if (RouteData != null)
{
    <CascadingValue Value="CurrentHub" Name="CurrentHub">
        <ErrorBoundary>
            <ChildContent>
                <LayoutView Layout="@GetPageLayoutType()">
                    <DynamicComponent Type="@RouteData.PageType" Parameters="@GetRouteParameters()" />
                </LayoutView>
            </ChildContent>
            <ErrorContent Context="errorInfo">
                <div class="error-boundary" style="padding: 2rem; background: #fee2e2; border: 1px solid #f87171; border-radius: 8px; margin: 1rem;">
                    <h3 style="color: #dc2626; margin-bottom: 1rem;">🚨 Component Rendering Error</h3>
                    <p style="margin-bottom: 1rem;"><strong>Component:</strong> @RouteData.PageType?.Name</p>
                    <p style="margin-bottom: 1rem;"><strong>Route:</strong> @(RouteData.PageType?.GetCustomAttributes(typeof(Microsoft.AspNetCore.Components.RouteAttribute), false)?.FirstOrDefault() as Microsoft.AspNetCore.Components.RouteAttribute)?.Template</p>
                    <details style="margin-top: 1rem;">
                        <summary style="cursor: pointer; font-weight: bold;">Error Details</summary>
                        <pre style="background: white; padding: 1rem; border-radius: 4px; overflow: auto; margin-top: 0.5rem;">@errorInfo.ToString()</pre>
                    </details>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </CascadingValue>
}

@code {
    [Parameter] public RouteData? RouteData { get; set; }
    [Parameter] public BusinessHub CurrentHub { get; set; }
    [Parameter] public Type? DefaultLayout { get; set; }

    protected override void OnParametersSet()
    {
        LogComponentRendering();
        base.OnParametersSet();
    }

    private void LogComponentRendering()
    {
        if (RouteData?.PageType != null)
        {
            Console.WriteLine($"[HubAwareRouteView] Rendering component: {RouteData.PageType.Name}");
            Console.WriteLine($"[HubAwareRouteView] Parameters count: {GetRouteParameters()?.Count ?? 0}");
            Console.WriteLine($"[HubAwareRouteView] Layout: {GetPageLayoutType()?.Name ?? "None"}");
            Console.WriteLine($"[HubAwareRouteView] Current Hub: {CurrentHub}");
            
            var routeParams = GetRouteParameters();
            if (routeParams?.Any() == true)
            {
                Console.WriteLine($"[HubAwareRouteView] Route parameters:");
                foreach (var param in routeParams)
                {
                    Console.WriteLine($"  - {param.Key}: {param.Value}");
                }
            }
        }
    }

    private Type? GetPageLayoutType()
    {
        var layoutType = RouteData?.PageType?.GetCustomAttribute<LayoutAttribute>()?.LayoutType ?? DefaultLayout;
        Console.WriteLine($"[HubAwareRouteView] Layout resolved: {layoutType?.Name ?? "DefaultLayout"}");
        return layoutType;
    }
    
    private Dictionary<string, object> GetRouteParameters()
    {
        if (RouteData?.RouteValues == null) return new Dictionary<string, object>();
        
        var parameters = new Dictionary<string, object>();
        
        // Copy route values safely
        foreach (var kvp in RouteData.RouteValues)
        {
            if (kvp.Value != null)
            {
                parameters[kvp.Key] = kvp.Value;
            }
        }
        
        // Add hub context as a parameter if the page supports it
        var hubContextProperty = RouteData.PageType?.GetProperty("HubContext");
        if (hubContextProperty != null)
        {
            parameters["HubContext"] = new { CurrentHub = CurrentHub };
        }
        
        return parameters;
    }
}