@using Jackson.Ideas.Mock.Models
@using Jackson.Ideas.Mock.Services.Interfaces
@inject IHubContextService HubContextService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        @if (IsHubAwareRoute(routeData))
        {
            <HubAwareRouteView RouteData="@routeData" DefaultLayout="@typeof(HubLayout)" 
                              CurrentHub="@_currentHub" />
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(HubLayout)" />
        }
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(HubLayout)">
            <div class="page-not-found hub-aware">
                <div class="not-found-content">
                    <i class="fas fa-compass not-found-icon"></i>
                    <h1>404 - Page Not Found</h1>
                    <p>The page you're looking for doesn't exist in your current hub context.</p>
                    <div class="not-found-actions">
                        <a href="/" class="btn btn-primary">
                            <i class="fas fa-home"></i>
                            Return to Home
                        </a>
                        <a href="/dashboard" class="btn btn-secondary">
                            <i class="fas fa-tachometer-alt"></i>
                            Go to Dashboard
                        </a>
                    </div>
                    @if (_currentHub != BusinessHub.IdeaDevelopment)
                    {
                        <div class="hub-navigation-suggestion">
                            <p class="text-muted">
                                You're currently in the <strong>@GetHubDisplayName(_currentHub)</strong> hub. 
                                Some features might be hub-specific.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private BusinessHub _currentHub = BusinessHub.IdeaDevelopment;
    private HubContext? _hubContext;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Subscribe to hub context changes
            HubContextService.ContextChanged += OnHubContextChanged;
            
            // Initialize current context with timeout
            var contextTask = HubContextService.GetCurrentContextAsync();
            var timeoutTask = Task.Delay(3000); // 3 second timeout
            
            var completedTask = await Task.WhenAny(contextTask, timeoutTask);
            if (completedTask == timeoutTask)
            {
                // Timeout - use default context
                _currentHub = BusinessHub.IdeaDevelopment;
                Console.WriteLine("HubRouter: Context loading timed out, using default hub");
            }
            else
            {
                _hubContext = await contextTask;
                _currentHub = _hubContext?.CurrentHub ?? BusinessHub.IdeaDevelopment;
                Console.WriteLine($"HubRouter: Context loaded successfully, hub = {_currentHub}");
            }
        }
        catch (Exception ex)
        {
            // Fallback to default hub if context service fails
            _currentHub = BusinessHub.IdeaDevelopment;
            Console.WriteLine($"HubRouter: Error loading context, using default hub: {ex.Message}");
        }
    }

    private void OnHubContextChanged(object? sender, HubContextChangedEventArgs e)
    {
        try
        {
            _currentHub = e.CurrentHub;
            InvokeAsync(StateHasChanged);
            
            // Optionally trigger any route-specific logic here
            InvokeAsync(async () =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("hubRouter.onHubChanged", e.CurrentHub.ToString());
                }
                catch (Exception jsEx)
                {
                    Console.WriteLine($"HubRouter: JS call failed: {jsEx.Message}");
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HubRouter: OnHubContextChanged failed: {ex.Message}");
        }
    }

    private bool IsHubAwareRoute(RouteData routeData)
    {
        // Define which routes are hub-aware and should receive hub context
        var hubAwareRoutes = new[]
        {
            "/dashboard",
            "/app/dashboard",
            "/test-dashboard",
            "/test-minimal",
            "/market-research-simple",
            "/service-diagnostic",
            "/idea-input",
            "/idea-validation",
            "/market-research",
            "/financial-projections",
            "/business-plan-builder",
            "/solution-design",
            "/business-model-canvas",
            "/design",
            "/development",
            "/launch",
            "/operations",
            "/hub-demo"
        };

        var route = routeData.PageType?.GetCustomAttributes(typeof(Microsoft.AspNetCore.Components.RouteAttribute), false)
                          ?.FirstOrDefault() as Microsoft.AspNetCore.Components.RouteAttribute;
        
        return route != null && hubAwareRoutes.Any(har => route.Template.StartsWith(har));
    }

    private string GetHubDisplayName(BusinessHub hub)
    {
        return hub switch
        {
            BusinessHub.IdeaDevelopment => "Idea Development",
            BusinessHub.BusinessPlanning => "Business Planning",
            BusinessHub.BusinessOperations => "Business Operations",
            _ => "Unknown Hub"
        };
    }

    public void Dispose()
    {
        try
        {
            if (HubContextService != null)
            {
                HubContextService.ContextChanged -= OnHubContextChanged;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HubRouter: Disposal error: {ex.Message}");
        }
    }
}

<style>
    .page-not-found.hub-aware {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 2rem;
    }

    .not-found-content {
        text-align: center;
        max-width: 500px;
    }

    .not-found-icon {
        font-size: 4rem;
        color: var(--primary-color);
        margin-bottom: 1.5rem;
        opacity: 0.6;
    }

    .not-found-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin: 2rem 0;
        flex-wrap: wrap;
    }

    .hub-navigation-suggestion {
        margin-top: 2rem;
        padding: 1.5rem;
        background: var(--secondary-color);
        border-radius: 0.75rem;
        border-left: 4px solid var(--primary-color);
    }

    @@media (max-width: 600px) {
        .not-found-actions {
            flex-direction: column;
            align-items: center;
        }
    }
</style>