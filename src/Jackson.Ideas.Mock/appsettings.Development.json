{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Jackson.Ideas.Mock": "Debug",
      "Jackson.Ideas.Mock.Services": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
      "LogToStandardErrorThreshold": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MockConfiguration": {
    "EnableDemoMode": true,
    "SimulateProcessingDelays": true,
    "UseStaticData": true,
    "MaxConcurrentOperations": 3,
    "EnableDetailedLogging": true,
    "CacheExpirationMinutes": 10,
    "EnableDebugMode": true,
    "EnableRealisticDelays": false,
    "MinProcessingDelayMs": 100,
    "MaxProcessingDelayMs": 500,
    "DefaultScenarioCount": 10,
    "SimulateErrors": true,
    "ErrorRate": 0.1
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedChecks": true,
    "CheckIntervalSeconds": 10
  },
  "Performance": {
    "EnableMetrics": true,
    "EnableGCOptimization": false,
    "MaxMemoryUsageMB": 128,
    "EnableProfiling": true
  },
  "Security": {
    "EnableRequestRateLimiting": false,
    "MaxRequestsPerMinute": 100,
    "EnableDetailedErrorResponses": true,
    "AllowCorsFromAnyOrigin": true
  },
  "Development": {
    "EnableHotReload": true,
    "ShowExceptionDetails": true,
    "EnableSensitiveDataLogging": true
  }
}