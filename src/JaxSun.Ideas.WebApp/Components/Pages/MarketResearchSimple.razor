@page "/market-research-simple"
@layout HubLayout

<PageTitle>Market Research (Simple) - Ideas Matter Demo</PageTitle>

<div style="padding: 2rem; background: #ecfdf5; border: 2px solid #10b981; border-radius: 8px;">
    <h1 style="color: #065f46; margin-bottom: 1rem;">🧪 Market Research - Simplified Version</h1>
    
    <div style="background: white; padding: 1.5rem; border-radius: 6px; margin: 1rem 0; border-left: 4px solid #10b981;">
        <h2 style="color: #065f46; margin-bottom: 1rem;">Testing Phase</h2>
        <p style="color: #065f46; margin-bottom: 0.5rem;">
            <strong>✅ Component Status:</strong> Successfully rendered without service dependencies
        </p>
        <p style="color: #065f46; margin-bottom: 0.5rem;">
            <strong>✅ Layout:</strong> Using /layout HubLayout directive
        </p>
        <p style="color: #065f46; margin-bottom: 0.5rem;">
            <strong>✅ Route:</strong> /market-research-simple
        </p>
        <p style="color: #065f46; margin-bottom: 0.5rem;">
            <strong>✅ Rendering:</strong> No service injections, no OnInitializedAsync
        </p>
    </div>

    <div style="background: #fef3c7; padding: 1.5rem; border-radius: 6px; margin: 1rem 0; border-left: 4px solid #f59e0b;">
        <h3 style="color: #92400e; margin-bottom: 1rem;">🔍 What This Tests</h3>
        <ul style="color: #92400e; margin: 0;">
            <li>Basic component rendering in HubLayout</li>
            <li>Route recognition and hub-aware routing</li>
            <li>Layout directive processing</li>
            <li>Component lifecycle without service dependencies</li>
        </ul>
    </div>

    <div style="background: #ddd6fe; padding: 1.5rem; border-radius: 6px; margin: 1rem 0; border-left: 4px solid #8b5cf6;">
        <h3 style="color: #5b21b6; margin-bottom: 1rem;">🔄 Next Steps</h3>
        <p style="color: #5b21b6; margin: 0;">
            If this renders successfully, we'll gradually add back service dependencies one by one 
            to identify which specific service injection is causing the original MarketResearch component to fail.
        </p>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <p style="color: #6b7280; font-size: 0.9em;">
            Current time: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
        </p>
    </div>
</div>

@code {
    // Simplified version with NO service injections
    // NO @inject statements
    // NO OnInitializedAsync
    // Just pure component rendering to test DynamicComponent + HubLayout flow
}