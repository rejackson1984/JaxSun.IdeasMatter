@page "/test-minimal"
@layout HubLayout

<div style="padding: 2rem; background: #f0f9ff; border: 2px solid #0ea5e9; border-radius: 8px;">
    <h1 style="color: #0c4a6e; margin-bottom: 1rem;">✅ Minimal Test Component</h1>
    <p style="color: #0c4a6e; margin-bottom: 1rem;">
        <strong>SUCCESS!</strong> If you can see this message, it proves that:
    </p>
    <ul style="color: #0c4a6e; margin-bottom: 1rem;">
        <li>✅ DynamicComponent is working</li>
        <li>✅ HubLayout is receiving ChildContent</li>
        <li>✅ Layout directive is recognized</li>
        <li>✅ Basic routing flow is functional</li>
    </ul>
    <p style="color: #0c4a6e; font-weight: bold;">
        Current time: @DateTime.Now.ToString("HH:mm:ss")
    </p>
    <p style="color: #0c4a6e; font-size: 0.9em; margin-top: 1rem;">
        This component has no service injections or complex logic - just pure rendering test.
    </p>
