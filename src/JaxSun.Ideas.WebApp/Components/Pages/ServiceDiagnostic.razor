@page "/service-diagnostic"
@layout HubLayout
@inject IServiceProvider ServiceProvider
@inject IMarketResearchService MarketResearchService
@inject IMockDataService MockDataService
@inject NavigationManager Navigation
@using JaxSun.Ideas.Mock.Services.Interfaces

<PageTitle>Service Diagnostic - Ideas Matter Demo</PageTitle>

<div style="padding: 2rem; background: #f3f4f6; border-radius: 8px;">
    <h1 style="color: #1f2937; margin-bottom: 2rem;">🔧 Service Diagnostic Tool</h1>
    
    <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
        
        <!-- Service Resolution Tests -->
        <div style="background: white; padding: 1.5rem; border-radius: 6px; border-left: 4px solid #3b82f6;">
            <h2 style="color: #1e40af; margin-bottom: 1rem;">📋 Service Resolution Tests</h2>
            
            <div style="margin-bottom: 1rem;">
                <strong>IMarketResearchService:</strong>
                <span style="color: @(_marketResearchServiceResolved ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                    @(_marketResearchServiceResolved ? "✅ RESOLVED" : "❌ FAILED")
                </span>
                @if (_marketResearchServiceError != null)
                {
                    <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                        Error: @_marketResearchServiceError
                    </div>
                }
            </div>
            
            <div style="margin-bottom: 1rem;">
                <strong>IMockDataService:</strong>
                <span style="color: @(_mockDataServiceResolved ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                    @(_mockDataServiceResolved ? "✅ RESOLVED" : "❌ FAILED")
                </span>
                @if (_mockDataServiceError != null)
                {
                    <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                        Error: @_mockDataServiceError
                    </div>
                }
            </div>
            
            <div style="margin-bottom: 1rem;">
                <strong>NavigationManager:</strong>
                <span style="color: @(_navigationManagerResolved ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                    @(_navigationManagerResolved ? "✅ RESOLVED" : "❌ FAILED")
                </span>
                @if (_navigationManagerError != null)
                {
                    <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                        Error: @_navigationManagerError
                    </div>
                }
            </div>
        </div>

        <!-- Service Provider Manual Resolution -->
        <div style="background: white; padding: 1.5rem; border-radius: 6px; border-left: 4px solid #8b5cf6;">
            <h2 style="color: #7c3aed; margin-bottom: 1rem;">🔍 Manual Service Provider Tests</h2>
            
            <div style="margin-bottom: 1rem;">
                <strong>ServiceProvider.GetService&lt;IMarketResearchService&gt;():</strong>
                <span style="color: @(_manualMarketResearchResolved ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                    @(_manualMarketResearchResolved ? "✅ RESOLVED" : "❌ FAILED")
                </span>
                @if (_manualMarketResearchError != null)
                {
                    <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                        Error: @_manualMarketResearchError
                    </div>
                }
            </div>
            
            <div style="margin-bottom: 1rem;">
                <strong>ServiceProvider.GetService&lt;IMockDataService&gt;():</strong>
                <span style="color: @(_manualMockDataResolved ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                    @(_manualMockDataResolved ? "✅ RESOLVED" : "❌ FAILED")
                </span>
                @if (_manualMockDataError != null)
                {
                    <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                        Error: @_manualMockDataError
                    </div>
                }
            </div>
        </div>

        <!-- Service Method Tests -->
        <div style="background: white; padding: 1.5rem; border-radius: 6px; border-left: 4px solid #10b981;">
            <h2 style="color: #065f46; margin-bottom: 1rem;">⚡ Service Method Tests</h2>
            
            <button @onclick="TestServiceMethods" 
                    style="background: #10b981; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 6px; cursor: pointer; margin-bottom: 1rem;">
                Test Service Methods
            </button>
            
            @if (_serviceMethodsTestRun)
            {
                <div style="margin-bottom: 1rem;">
                    <strong>MockDataService.GetAllScenariosAsync():</strong>
                    <span style="color: @(_mockDataMethodWorked ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                        @(_mockDataMethodWorked ? $"✅ SUCCESS ({_scenarioCount} scenarios)" : "❌ FAILED")
                    </span>
                    @if (_mockDataMethodError != null)
                    {
                        <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                            Error: @_mockDataMethodError
                        </div>
                    }
                </div>
                
                <div style="margin-bottom: 1rem;">
                    <strong>MarketResearchService.GetMarketResearchAsync():</strong>
                    <span style="color: @(_marketResearchMethodWorked ? "#10b981" : "#ef4444"); margin-left: 0.5rem;">
                        @(_marketResearchMethodWorked ? "✅ SUCCESS" : "❌ FAILED")
                    </span>
                    @if (_marketResearchMethodError != null)
                    {
                        <div style="color: #ef4444; font-size: 0.9em; margin-top: 0.5rem;">
                            Error: @_marketResearchMethodError
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    
    <div style="text-align: center; color: #6b7280; font-size: 0.9em;">
        Last updated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
    </div>
</div>

@code {
    // Service Resolution Flags
    private bool _marketResearchServiceResolved = false;
    private bool _mockDataServiceResolved = false;
    private bool _navigationManagerResolved = false;
    private string? _marketResearchServiceError = null;
    private string? _mockDataServiceError = null;
    private string? _navigationManagerError = null;
    
    // Manual Resolution Flags
    private bool _manualMarketResearchResolved = false;
    private bool _manualMockDataResolved = false;
    private string? _manualMarketResearchError = null;
    private string? _manualMockDataError = null;
    
    // Service Method Test Flags
    private bool _serviceMethodsTestRun = false;
    private bool _mockDataMethodWorked = false;
    private bool _marketResearchMethodWorked = false;
    private string? _mockDataMethodError = null;
    private string? _marketResearchMethodError = null;
    private int _scenarioCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await TestServiceResolution();
    }

    private async Task TestServiceResolution()
    {
        // Test service injection resolution
        try
        {
            _marketResearchServiceResolved = MarketResearchService != null;
        }
        catch (Exception ex)
        {
            _marketResearchServiceError = ex.Message;
        }

        try
        {
            _mockDataServiceResolved = MockDataService != null;
        }
        catch (Exception ex)
        {
            _mockDataServiceError = ex.Message;
        }

        try
        {
            _navigationManagerResolved = Navigation != null;
        }
        catch (Exception ex)
        {
            _navigationManagerError = ex.Message;
        }

        // Test manual ServiceProvider resolution
        try
        {
            var marketService = ServiceProvider.GetService<IMarketResearchService>();
            _manualMarketResearchResolved = marketService != null;
        }
        catch (Exception ex)
        {
            _manualMarketResearchError = ex.Message;
        }

        try
        {
            var mockService = ServiceProvider.GetService<IMockDataService>();
            _manualMockDataResolved = mockService != null;
        }
        catch (Exception ex)
        {
            _manualMockDataError = ex.Message;
        }

        StateHasChanged();
    }

    private async Task TestServiceMethods()
    {
        _serviceMethodsTestRun = true;
        
        // Test MockDataService method
        try
        {
            var scenarios = await MockDataService.GetAllScenariosAsync();
            _mockDataMethodWorked = scenarios != null;
            _scenarioCount = scenarios?.Count ?? 0;
        }
        catch (Exception ex)
        {
            _mockDataMethodError = ex.Message;
        }

        // Test MarketResearchService method
        try
        {
            var marketData = await MarketResearchService.GetMarketResearchAsync("test-scenario-1");
            _marketResearchMethodWorked = marketData != null;
        }
        catch (Exception ex)
        {
            _marketResearchMethodError = ex.Message;
        }

        StateHasChanged();
    }
}