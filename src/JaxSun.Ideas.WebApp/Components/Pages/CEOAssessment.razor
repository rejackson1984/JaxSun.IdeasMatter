@page "/ceo-assessment"
@layout HubLayout
@using JaxSun.Ideas.WebApp.Services.Interfaces
@using JaxSun.Ideas.WebApp.Models
@inject IHubContextService HubContextService
@inject ICoachPersonaService CoachPersonaService
@inject NavigationManager Navigation

<PageTitle>CEO Leadership Assessment - Execute Coach</PageTitle>

<div class="ceo-assessment-container">
    <!-- Execute Coach Welcome Section -->
    <div class="coach-welcome-section hub-operations-theme">
        <div class="coach-welcome-content">
            <div class="coach-avatar-large hub-operations-avatar">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="welcome-text-content">
                <h1 class="coach-welcome-title">Executive Leadership Assessment 👔</h1>
                <p class="coach-message-text">Let's evaluate your leadership capabilities and create a personalized development plan to maximize your effectiveness as a CEO.</p>
                <div class="coach-guidance">
                    <div class="guidance-item">
                        <i class="fas fa-brain"></i>
                        <span>Assess strategic thinking and decision-making abilities</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-users"></i>
                        <span>Evaluate team leadership and communication skills</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-chart-bar"></i>
                        <span>Identify growth opportunities and development priorities</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="assessment-intro">
            <div class="intro-card">
                <div class="intro-header">
                    <h2>🎯 Leadership Assessment Overview</h2>
                    <p>This comprehensive assessment evaluates four key areas of executive leadership</p>
                </div>
                <div class="assessment-areas">
                    <div class="area-item">
                        <div class="area-icon">🧠</div>
                        <div class="area-content">
                            <h3>Strategic Thinking</h3>
                            <p>Vision setting, long-term planning, and strategic decision-making</p>
                        </div>
                    </div>
                    <div class="area-item">
                        <div class="area-icon">👥</div>
                        <div class="area-content">
                            <h3>Team Leadership</h3>
                            <p>People management, team building, and organizational culture</p>
                        </div>
                    </div>
                    <div class="area-item">
                        <div class="area-icon">⚡</div>
                        <div class="area-content">
                            <h3>Decision Making</h3>
                            <p>Problem-solving, risk assessment, and execution excellence</p>
                        </div>
                    </div>
                    <div class="area-item">
                        <div class="area-icon">💬</div>
                        <div class="area-content">
                            <h3>Communication</h3>
                            <p>Stakeholder engagement, public speaking, and influence</p>
                        </div>
                    </div>
                </div>
                <div class="intro-actions">
                    <p class="time-estimate">⏱️ Estimated time: 15-20 minutes</p>
                    <button class="btn btn-lg btn-primary" @onclick="StartAssessment">
                        <i class="fas fa-play"></i>
                        Start Assessment (Coming Soon)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void StartAssessment()
    {
        // TODO: Implement full assessment functionality
    }
}

<style>
    /* CEO Assessment Styles */
    .ceo-assessment-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }

    /* Coach Welcome Section - Operations Theme */
    .hub-operations-theme {
        background: linear-gradient(135deg, #4c5fd715, #05966915);
        border-bottom: 3px solid #4c5fd725;
    }

    .hub-operations-avatar {
        background: linear-gradient(135deg, #4c5fd7, #059669);
    }

    /* Assessment Introduction */
    .assessment-intro {
        padding: 2rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    .intro-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .intro-header {
        background: linear-gradient(135deg, #4c5fd7, #059669);
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .intro-header h2 {
        margin: 0 0 0.5rem 0;
        font-size: 2rem;
        font-weight: 700;
    }

    .intro-header p {
        margin: 0;
        font-size: 1.125rem;
        opacity: 0.9;
    }

    .assessment-areas {
        padding: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .area-item {
        text-align: center;
        padding: 1.5rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .area-item:hover {
        border-color: #4c5fd7;
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(76, 95, 215, 0.15);
    }

    .area-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .area-content h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        color: #1a202c;
    }

    .area-content p {
        color: #64748b;
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.4;
    }

    .intro-actions {
        padding: 2rem;
        text-align: center;
        border-top: 1px solid #e2e8f0;
    }

    .time-estimate {
        color: #64748b;
        margin-bottom: 1.5rem;
        font-size: 1rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .assessment-areas {
            grid-template-columns: 1fr;
        }
    }
</style>