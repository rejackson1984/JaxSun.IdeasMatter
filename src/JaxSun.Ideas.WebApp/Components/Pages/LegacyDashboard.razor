<!-- Achievement Celebration Popup (triggered by achievements) -->
@if (showAchievementCelebration)
{
    <div class="achievement-celebration">
        <div class="achievement-header">
            <div class="achievement-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="achievement-content">
                <h3 class="achievement-title">Achievement Unlocked!</h3>
                <p class="achievement-subtitle">Strategic Planner</p>
            </div>
        </div>
        <p class="achievement-description">
            You've completed 3 strategic planning tasks and proven you can think like a CEO. Your business foundation is getting stronger!
        </p>
        <div class="achievement-rewards">
            <span class="reward-badge">+200 XP</span>
            <span class="reward-badge">Level Up!</span>
        </div>
        <div class="achievement-actions">
            <button class="achievement-btn secondary" @onclick="DismissAchievement">Dismiss</button>
            <button class="achievement-btn primary" @onclick="ShareAchievement">Share</button>
        </div>
    </div>
}

<!-- Confetti Animation for Celebrations -->
@if (showConfetti)
{
    <div class="confetti-container">
        @for (int i = 0; i < 50; i++)
        {
            <div class="confetti" style="left: @(Random.Shared.Next(0, 100))%; animation-delay: @(Random.Shared.Next(0, 1000))ms;"></div>
        }
    </div>
}

@code {
    private bool showAchievementCelebration = false;
    private bool showConfetti = false;

    private void DismissAchievement()
    {
        showAchievementCelebration = false;
        showConfetti = false;
    }

    private void ShareAchievement()
    {
        // Implement sharing logic
        DismissAchievement();
    }

    // Simulate achievement trigger (this would normally be called when user completes tasks)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Simulate achievement after 3 seconds for demonstration
            await Task.Delay(3000);
            await TriggerAchievement();
        }
    }

    private async Task TriggerAchievement()
    {
        showAchievementCelebration = true;
        showConfetti = true;
        StateHasChanged();
        
        // Auto-dismiss after 8 seconds
        await Task.Delay(8000);
        if (showAchievementCelebration)
        {
            DismissAchievement();
            StateHasChanged();
        }
    }
}
