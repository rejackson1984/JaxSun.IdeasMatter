                Rating = "4.8",
                Description = "Comprehensive program on strategic thinking and organizational leadership"
            },
            new() {
                Id = "communication-book",
                Title = "Crucial Conversations",
                Author = "Kerry Patterson",
                Type = "Book",
                Duration = "8 hours",
                Rating = "4.6",
                Description = "Tools for talking when stakes are high and emotions run strong"
            },
            new() {
                Id = "leadership-podcast",
                Title = "Stanford Leadership Podcast",
                Author = "Stanford GSB",
                Type = "Podcast",
                Duration = "45 min/episode",
                Rating = "4.7",
                Description = "Insights from world-class leaders and leadership researchers"
            }
        };
    }

    private List<Mentor> GetMentors()
    {
        return new List<Mentor>
        {
            new() {
                Id = "sarah-chen",
                Name = "Dr. Sarah Chen",
                Role = "Former CEO",
                Expertise = "Strategic Leadership",
                Icon = "fas fa-user-tie"
            },
            new() {
                Id = "mike-rodriguez",
                Name = "Mike Rodriguez",
                Role = "VP of Operations",
                Expertise = "Team Building",
                Icon = "fas fa-users"
            }
        };
    }

    private List<Achievement> GetRecentAchievements()
    {
        return new List<Achievement>
        {
            new() {
                Id = "strategic-badge",
                Title = "Strategic Thinker Badge",
                Icon = "🎯",
                Description = "Completed advanced strategic planning certification",
                Date = DateTime.Now.AddDays(-7),
                IsCompleted = true,
                Progress = 100
            },
            new() {
                Id = "communication-milestone",
                Title = "Executive Presenter",
                Icon = "🎤",
                Description = "Complete 10 executive presentations with 4.5+ rating",
                Date = DateTime.Now.AddDays(14),
                IsCompleted = false,
                Progress = 70
            },
            new() {
                Id = "team-builder",
                Title = "Team Builder Certification",
                Icon = "👥",
                Description = "Successfully implement team development program",
                Date = DateTime.Now.AddDays(30),
                IsCompleted = false,
                Progress = 25
            }
        };
    }

    private string GetResourceTypeIcon(string type)
    {
        return type switch
        {
            "Course" => "🎓",
            "Book" => "📚",
            "Podcast" => "🎧",
            "Video" => "📹",
            "Article" => "📄",
            _ => "📖"
        };
    }

    private string GetResourceActionText(string type)
    {
        return type switch
        {
            "Course" => "Enroll",
            "Book" => "Read",
            "Podcast" => "Listen",
            "Video" => "Watch",
            "Article" => "Read",
            _ => "Access"
        };
    }

    // Event handlers
    private void ViewAllAreas() => Navigation.NavigateTo("/development-areas");
    private void ContinueDevelopment(string areaId) => Navigation.NavigateTo($"/development/{areaId}");
    private void ViewAreaDetails(string areaId) => Navigation.NavigateTo($"/development/{areaId}/details");
    private void StartAction(string actionId) => Navigation.NavigateTo($"/action/{actionId}");
    private void ViewAllResources() => Navigation.NavigateTo("/learning-resources");
    private void AccessResource(string resourceId) => Navigation.NavigateTo($"/resource/{resourceId}");
    private void SaveResource(string resourceId) { /* Save logic */ }
    private void FindMentor() => Navigation.NavigateTo("/mentor-network");
    private void JoinSession() => Navigation.NavigateTo("/coaching-session");
    private void RescheduleSession() { /* Reschedule logic */ }
    private void ContactMentor(string mentorId) => Navigation.NavigateTo($"/mentor/{mentorId}/message");

    public void Dispose() { }

    // Data classes
    public class DevelopmentArea
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Description { get; set; } = "";
        public string Priority { get; set; } = "";
        public int Progress { get; set; }
        public string CurrentMilestone { get; set; } = "";
    }

    public class NextAction
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Description { get; set; } = "";
        public string Priority { get; set; } = "";
        public string EstimatedTime { get; set; } = "";
    }

    public class LearningResource
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string Type { get; set; } = "";
        public string Duration { get; set; } = "";
        public string Rating { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class Mentor
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Expertise { get; set; } = "";
        public string Icon { get; set; } = "";
    }

    public class Achievement
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime Date { get; set; }
        public bool IsCompleted { get; set; }
        public int Progress { get; set; }
    }
}

<style>
    /* Leadership Development Styles */
    .leadership-development-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }

    /* Coach Welcome Section - Operations Theme */
    .hub-operations-theme {
        background: linear-gradient(135deg, #4c5fd715, #05966915);
        border-bottom: 3px solid #4c5fd725;
    }

    .hub-operations-avatar {
        background: linear-gradient(135deg, #4c5fd7, #059669);
    }

    /* Progress Overview Card */
    .progress-overview-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .progress-overview-card .card-header {
        background: linear-gradient(135deg, #4c5fd7, #059669);
        color: white;
        padding: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .progress-overview-card .card-header h2 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .overall-score {
        text-align: center;
    }

    .score-circle {
        width: 80px;
        height: 80px;
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
    }

    .score-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        line-height: 1;
    }

    .score-label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.8);
        text-transform: uppercase;
    }

    .progress-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        padding: 2rem;
    }

    .metric-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .metric-icon {
        font-size: 2rem;
        width: 3rem;
        text-align: center;
        flex-shrink: 0;
    }

    .metric-content {
        flex: 1;
    }

    .metric-label {
        font-size: 0.875rem;
        color: #64748b;
        margin-bottom: 0.25rem;
    }

    .metric-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 0.25rem;
    }

    .metric-detail {
        font-size: 0.75rem;
        color: #64748b;
    }

    .metric-progress {
        margin-top: 0.5rem;
    }

    .progress-bar {
        height: 6px;
        background: #e2e8f0;
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(135deg, #4c5fd7, #059669);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    /* Development Areas Card */
    .development-areas-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        height: 100%;
    }

    .development-areas-card .card-header {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .development-areas-card .card-header h3 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
    }

    .development-area {
        padding: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        border-left: 4px solid transparent;
    }

    .development-area:last-child {
        border-bottom: none;
    }

    .development-area.high {
        border-left-color: #dc2626;
        background: #fef2f2;
    }

    .development-area.medium {
        border-left-color: #d97706;
        background: #fffbeb;
    }

    .development-area.low {
        border-left-color: #059669;
        background: #ecfdf5;
    }

    .area-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .area-info {
        display: flex;
        gap: 1rem;
        flex: 1;
    }

    .area-icon {
        font-size: 2rem;
        width: 3rem;
        text-align: center;
        flex-shrink: 0;
    }

    .area-content {
        flex: 1;
    }

    .area-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1a202c;
        margin: 0 0 0.5rem 0;
    }

    .area-description {
        color: #64748b;
        margin: 0;
        line-height: 1.4;
    }

    .area-progress {
        flex-shrink: 0;
    }

    .progress-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: white;
        font-size: 0.875rem;
    }

    .progress-circle.high {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
    }

    .progress-circle.medium {
        background: linear-gradient(135deg, #d97706, #b45309);
