@page "/leadership-development"
@layout HubLayout
@using JaxSun.Ideas.Mock.Services.Interfaces
@using JaxSun.Ideas.Mock.Models
@inject IHubContextService HubContextService
@inject ICoachPersonaService CoachPersonaService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Leadership Development Plan - Execute Coach</PageTitle>

<div class="leadership-development-container">
    <!-- Execute Coach Welcome Section -->
    <div class="coach-welcome-section hub-operations-theme">
        <div class="coach-welcome-content">
            <div class="coach-avatar-large hub-operations-avatar">
                <i class="fas fa-rocket"></i>
            </div>
            <div class="welcome-text-content">
                <h1 class="coach-welcome-title">Executive Leadership Development 🚀</h1>
                <p class="coach-message-text">Your personalized development plan designed to elevate your leadership effectiveness and drive exceptional business results.</p>
                <div class="coach-guidance">
                    <div class="guidance-item">
                        <i class="fas fa-target"></i>
                        <span>Focus on high-impact development priorities</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-chart-line"></i>
                        <span>Track progress with measurable milestones</span>
                    </div>
                    <div class="guidance-item">
                        <i class="fas fa-users"></i>
                        <span>Connect with mentors and leadership resources</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        
        <!-- Development Progress Overview -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="progress-overview-card">
                    <div class="card-header">
                        <h2>📊 Your Leadership Development Progress</h2>
                        <div class="overall-score">
                            <div class="score-circle">
                                <div class="score-value">78%</div>
                                <div class="score-label">Overall</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="progress-metrics">
                            <div class="metric-item">
                                <div class="metric-icon">🎯</div>
                                <div class="metric-content">
                                    <div class="metric-label">Goals Completed</div>
                                    <div class="metric-value">7 of 12</div>
                                    <div class="metric-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: 58%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-icon">⏱️</div>
                                <div class="metric-content">
                                    <div class="metric-label">Time Invested</div>
                                    <div class="metric-value">24 hours</div>
                                    <div class="metric-detail">This month</div>
                                </div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-icon">📈</div>
                                <div class="metric-content">
                                    <div class="metric-label">Skill Growth</div>
                                    <div class="metric-value">+15%</div>
                                    <div class="metric-detail">Since last assessment</div>
                                </div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-icon">🏆</div>
                                <div class="metric-content">
                                    <div class="metric-label">Achievements</div>
                                    <div class="metric-value">3 badges</div>
                                    <div class="metric-detail">Earned this quarter</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Development Areas -->
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="development-areas-card">
                    <div class="card-header">
                        <h3>🎯 Active Development Areas</h3>
                        <button class="btn btn-sm btn-outline-light" @onclick="ViewAllAreas">
                            View All
                        </button>
                    </div>
                    <div class="card-body">
                        @foreach (var area in GetActiveDevelopmentAreas())
                        {
                            <div class="development-area @area.Priority.ToLower()">
                                <div class="area-header">
                                    <div class="area-info">
                                        <div class="area-icon">@area.Icon</div>
                                        <div class="area-content">
                                            <h4 class="area-title">@area.Title</h4>
                                            <p class="area-description">@area.Description</p>
                                        </div>
                                    </div>
                                    <div class="area-progress">
                                        <div class="progress-circle @area.Priority.ToLower()">
                                            <div class="progress-value">@area.Progress%</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="area-actions">
                                    <div class="current-milestone">
                                        <strong>Current:</strong> @area.CurrentMilestone
                                    </div>
                                    <div class="action-buttons">
                                        <button class="btn btn-sm btn-primary" @onclick="() => ContinueDevelopment(area.Id)">
                                            Continue
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewAreaDetails(area.Id)">
                                            Details
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="next-actions-card">
                    <div class="card-header">
                        <h3>⚡ Next Actions</h3>
                    </div>
                    <div class="card-body">
                        @foreach (var action in GetNextActions())
                        {
                            <div class="next-action @action.Priority.ToLower()">
                                <div class="action-header">
                                    <div class="action-icon">@action.Icon</div>
                                    <div class="action-info">
                                        <div class="action-title">@action.Title</div>
                                        <div class="action-time">@action.EstimatedTime</div>
                                    </div>
                                    <div class="action-priority @action.Priority.ToLower()">@action.Priority</div>
                                </div>
                                <div class="action-description">@action.Description</div>
                                <button class="btn btn-sm btn-primary action-btn" @onclick="() => StartAction(action.Id)">
                                    Start Now
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Learning Resources & Mentorship -->
        <div class="row mb-4">
            <div class="col-lg-6">
                <div class="resources-card">
                    <div class="card-header">
                        <h3>📚 Learning Resources</h3>
                        <button class="btn btn-sm btn-outline-light" @onclick="ViewAllResources">
                            Browse All
                        </button>
                    </div>
                    <div class="card-body">
                        @foreach (var resource in GetRecommendedResources())
                        {
                            <div class="resource-item">
                                <div class="resource-header">
                                    <div class="resource-type @resource.Type.ToLower()">@GetResourceTypeIcon(resource.Type)</div>
                                    <div class="resource-info">
                                        <h4 class="resource-title">@resource.Title</h4>
                                        <div class="resource-meta">
                                            <span class="resource-author">@resource.Author</span>
                                            <span class="resource-duration">@resource.Duration</span>
                                            <span class="resource-rating">⭐ @resource.Rating</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="resource-description">@resource.Description</div>
                                <div class="resource-actions">
                                    <button class="btn btn-sm btn-primary" @onclick="() => AccessResource(resource.Id)">
                                        @GetResourceActionText(resource.Type)
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SaveResource(resource.Id)">
                                        Save
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="mentorship-card">
                    <div class="card-header">
                        <h3>👥 Mentorship & Coaching</h3>
                        <button class="btn btn-sm btn-outline-light" @onclick="FindMentor">
                            Find Mentor
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="coaching-sessions">
                            <div class="session-item upcoming">
                                <div class="session-header">
                                    <div class="session-type">1:1 Coaching</div>
                                    <div class="session-date">Tomorrow, 2:00 PM</div>
                                </div>
                                <div class="session-coach">
                                    <div class="coach-avatar">
                                        <i class="fas fa-user-tie"></i>
                                    </div>
                                    <div class="coach-info">
                                        <div class="coach-name">Dr. Sarah Chen</div>
                                        <div class="coach-specialty">Executive Leadership</div>
                                    </div>
                                </div>
                                <div class="session-topic">Strategic Decision Making</div>
                                <div class="session-actions">
                                    <button class="btn btn-sm btn-primary" @onclick="JoinSession">
                                        Join Session
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="RescheduleSession">
                                        Reschedule
                                    </button>
                                </div>
                            </div>

                            <div class="mentor-network">
                                <h4>Your Mentor Network</h4>
                                <div class="mentors-list">
                                    @foreach (var mentor in GetMentors())
                                    {
                                        <div class="mentor-item">
                                            <div class="mentor-avatar">
                                                <i class="@mentor.Icon"></i>
                                            </div>
                                            <div class="mentor-info">
                                                <div class="mentor-name">@mentor.Name</div>
                                                <div class="mentor-role">@mentor.Role</div>
                                                <div class="mentor-expertise">@mentor.Expertise</div>
                                            </div>
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => ContactMentor(mentor.Id)">
                                                Message
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Achievement & Milestones -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="achievements-card">
                    <div class="card-header">
                        <h3>🏆 Achievements & Milestones</h3>
                        <div class="achievement-stats">
                            <span class="stat-item">
                                <span class="stat-value">12</span>
                                <span class="stat-label">Badges Earned</span>
                            </span>
                            <span class="stat-item">
                                <span class="stat-value">Level 4</span>
                                <span class="stat-label">Leadership Level</span>
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="achievements-timeline">
                            @foreach (var achievement in GetRecentAchievements())
                            {
                                <div class="achievement-item @(achievement.IsCompleted ? "completed" : "pending")">
                                    <div class="achievement-marker">
                                        <div class="marker-icon">@achievement.Icon</div>
                                    </div>
                                    <div class="achievement-content">
                                        <div class="achievement-header">
                                            <h4 class="achievement-title">@achievement.Title</h4>
                                            <div class="achievement-date">@achievement.Date.ToString("MMM dd, yyyy")</div>
                                        </div>
                                        <div class="achievement-description">@achievement.Description</div>
                                        @if (!achievement.IsCompleted)
                                        {
                                            <div class="achievement-progress">
                                                <div class="progress-bar">
                                                    <div class="progress-fill" style="width: @achievement.Progress%"></div>
                                                </div>
                                                <span class="progress-text">@achievement.Progress% complete</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Initialize component
    }

