                Icon = "🧠",
                Description = "Developing long-term vision and strategic planning capabilities",
                Priority = "High",
                Progress = 65,
                CurrentMilestone = "Complete strategic planning framework course"
            },
            new() {
                Id = "communication",
                Title = "Executive Communication",
                Icon = "💬",
                Description = "Enhancing stakeholder engagement and presentation skills",
                Priority = "Medium",
                Progress = 40,
                CurrentMilestone = "Practice public speaking with feedback"
            },
            new() {
                Id = "team-leadership",
