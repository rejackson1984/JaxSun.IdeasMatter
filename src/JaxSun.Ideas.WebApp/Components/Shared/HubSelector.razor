@using JaxSun.Ideas.Mock.Models
@using JaxSun.Ideas.Mock.Services.Interfaces
@inject IHubContextService HubContextService
@inject IHubConfigurationService HubConfigurationService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="hub-selector">
    <div class="hub-selector-header">
        <h4 class="selector-title">Business Hubs</h4>
        <div class="overall-progress">
            <div class="progress-circle">
                <svg class="progress-ring" width="40" height="40">
                    <circle class="progress-ring-circle" 
                            stroke="currentColor" 
                            stroke-width="3" 
                            fill="transparent" 
                            r="16" 
                            cx="20" 
                            cy="20"
                            style="stroke-dasharray: @(_circumference); stroke-dashoffset: @(_progressOffset)"/>
                </svg>
                <span class="progress-text">@(_overallProgress)%</span>
            </div>
        </div>
    </div>

    <div class="hub-list">
        @if (_hubMetadata != null && _hubContext != null)
        {
            @foreach (var hub in Enum.GetValues<BusinessHub>())
            {
                var metadata = _hubMetadata.GetValueOrDefault(hub, new HubMetadata());
                var progress = _hubContext.Progress.GetValueOrDefault(hub, new HubProgressStatus());
                var isCurrentHub = _hubContext.CurrentHub == hub;
                var canAccess = _hubContext.CanAccessHub(hub);

                <div class="hub-item @(isCurrentHub ? "active" : "") @(!canAccess ? "locked" : "")"
                     @onclick="() => SwitchToHub(hub)"
                     role="button"
                     tabindex="@(canAccess ? "0" : "-1")">
                    
                    <div class="hub-icon">
                        <i class="@metadata.Icon"></i>
                        @if (isCurrentHub)
                        {
                            <div class="active-indicator"></div>
                        }
                    </div>
                    
                    <div class="hub-content">
                        <div class="hub-name">@metadata.Name</div>
                        <div class="hub-description">@GetHubShortDescription(hub)</div>
                        
                        <div class="hub-progress">
                            @if (canAccess)
                            {
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @(progress.CompletionPercentage)%"></div>
                                </div>
                                <span class="progress-percentage">@(progress.CompletionPercentage)%</span>
                            }
                            else
                            {
                                <div class="lock-indicator">
                                    <i class="fas fa-lock"></i>
                                    <span>Complete @GetUnlockThreshold(hub)% of previous hub</span>
                                </div>
                            }
                        </div>
                    </div>
                    
                    @if (canAccess && !isCurrentHub)
                    {
                        <div class="hub-action">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (_isTransitioning)
    {
        <div class="transition-indicator">
            <div class="spinner"></div>
            <span>Switching hubs...</span>
        </div>
    }
</div>

@code {
    private HubContext? _hubContext;
    private Dictionary<BusinessHub, HubMetadata>? _hubMetadata;
    private bool _isTransitioning = false;
    private int _overallProgress = 0;
    private double _circumference = 2 * Math.PI * 16; // radius = 16
    private double _progressOffset = 0;

    protected override async Task OnInitializedAsync()
    {
        HubContextService.ContextChanged += OnHubContextChanged;
        await LoadData();
    }

    private async Task LoadData()
    {
        _hubContext = await HubContextService.GetCurrentContextAsync();
        _hubMetadata = await HubConfigurationService.GetAllHubMetadataAsync();
        UpdateProgress();
        StateHasChanged();
    }

    private void UpdateProgress()
    {
        if (_hubContext == null) return;
        
        _overallProgress = _hubContext.GetOverallCompletion();
        _progressOffset = _circumference - (_overallProgress / 100.0 * _circumference);
    }

    private async void OnHubContextChanged(object? sender, HubContextChangedEventArgs e)
    {
        _hubContext = e.Context;
        UpdateProgress();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SwitchToHub(BusinessHub hub)
    {
        if (_isTransitioning || _hubContext?.CurrentHub == hub || !(_hubContext?.CanAccessHub(hub) ?? false))
            return;

        _isTransitioning = true;
        StateHasChanged();

        try
        {
            var success = await HubContextService.SwitchToHubAsync(hub);
            if (!success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Unable to switch to this hub. Please complete the required milestones first.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error switching hub: {ex.Message}");
        }
        finally
        {
            _isTransitioning = false;
            StateHasChanged();
        }
    }

    private string GetHubShortDescription(BusinessHub hub)
    {
        return hub switch
        {
            BusinessHub.IdeaDevelopment => "Discover & validate ideas",
            BusinessHub.BusinessPlanning => "Plan & design solution", 
            BusinessHub.BusinessOperations => "Launch & scale business",
            _ => "Unknown hub"
        };
    }

    private int GetUnlockThreshold(BusinessHub hub)
    {
        return hub switch
        {
            BusinessHub.BusinessPlanning => 70,
            BusinessHub.BusinessOperations => 80,
            _ => 0
        };
    }

    public void Dispose()
    {
        HubContextService.ContextChanged -= OnHubContextChanged;
    }
}

<style>
    .hub-selector {
        background: white;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin: 1rem 0;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-light);
    }

    .hub-selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .selector-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .overall-progress .progress-circle {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .progress-ring {
        transform: rotate(-90deg);
    }

    .progress-ring-circle {
        transition: stroke-dashoffset 0.5s ease;
        opacity: 0.3;
    }

    .progress-text {
        position: absolute;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--hub-primary, var(--primary-color));
    }

    .hub-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .hub-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        border-radius: 0.5rem;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .hub-item:hover:not(.locked) {
        background: var(--secondary-color);
        border-color: var(--hub-primary, var(--primary-color));
        transform: translateX(4px);
    }

    .hub-item.active {
        background: linear-gradient(135deg, var(--hub-primary, var(--primary-color)) 0%, var(--hub-secondary, var(--primary-dark)) 100%);
        color: white;
        border-color: var(--hub-primary, var(--primary-color));
    }

    .hub-item.locked {
        opacity: 0.5;
        cursor: not-allowed;
        background: #f8f9fa;
    }

    .hub-icon {
        position: relative;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--hub-primary, var(--primary-color));
        color: white;
        border-radius: 0.5rem;
        margin-right: 1rem;
        font-size: 1.2rem;
    }

    .hub-item.active .hub-icon {
        background: rgba(255, 255, 255, 0.2);
    }

    .hub-item.locked .hub-icon {
        background: #dee2e6;
        color: #6c757d;
    }

    .active-indicator {
        position: absolute;
        top: -4px;
        right: -4px;
        width: 12px;
        height: 12px;
        background: var(--success-color);
        border-radius: 50%;
        border: 2px solid white;
    }

    .hub-content {
        flex: 1;
    }

    .hub-name {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .hub-description {
        font-size: 0.875rem;
        opacity: 0.7;
        margin-bottom: 0.5rem;
    }

    .hub-item.active .hub-description {
        opacity: 0.9;
    }

    .hub-progress {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .progress-bar {
        flex: 1;
        height: 4px;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 2px;
        overflow: hidden;
    }

    .hub-item.active .progress-bar {
        background: rgba(255, 255, 255, 0.3);
    }

    .progress-fill {
        height: 100%;
        background: var(--hub-primary, var(--primary-color));
        transition: width 0.3s ease;
    }

    .hub-item.active .progress-fill {
        background: white;
    }

    .progress-percentage {
        font-size: 0.75rem;
        font-weight: 600;
        min-width: 35px;
        text-align: right;
    }

    .lock-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        color: #6c757d;
    }

    .hub-action {
        margin-left: 1rem;
        opacity: 0.5;
        transition: opacity 0.3s ease;
    }

    .hub-item:hover .hub-action {
        opacity: 1;
    }

    .transition-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid var(--border-color);
        border-top: 2px solid var(--hub-primary, var(--primary-color));
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .hub-selector {
            margin: 0.5rem 0;
            padding: 1rem;
        }

        .hub-item {
            padding: 0.75rem;
        }

        .hub-icon {
            width: 32px;
            height: 32px;
            font-size: 1rem;
        }
    }
</style>