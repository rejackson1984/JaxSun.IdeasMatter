{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "JaxSun.Ideas.Mock": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
    }
  },
  "AllowedHosts": "*",
  "MockConfiguration": {
    "EnableDemoMode": true,
    "SimulateProcessingDelays": true,
    "UseStaticData": true,
    "MaxConcurrentOperations": 5,
    "EnableDetailedLogging": true,
    "CacheExpirationMinutes": 30
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedChecks": true,
    "CheckIntervalSeconds": 15
  },
  "Performance": {
    "EnableMetrics": true,
    "EnableGCOptimization": false,
    "MaxMemoryUsageMB": 256
  },
  "Security": {
    "EnableRequestRateLimiting": true,
    "MaxRequestsPerMinute": 500,
    "EnableDetailedErrorResponses": true
  }
}